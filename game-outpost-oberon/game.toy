const GAME_STATE_PLAY      = 1
const GAME_STATE_GAME_OVER = 2


struct Game:
    state

var game: Game


const TS        = 16  # tile size
const SP        = 16  # subpixel
const GRAVITY   = 2

include "level.toy"


# collision debugging
struct Dot:
    x
    y
var dots: Dot[99]
var dot_count
func dot(x, y):
    dots[dot_count] = {x, y}
    dot_count += 1

func draw_dots():
    for i = 0, dot_count:
        var d = dots[i]
        # camera_sprite(d.x, d.y, 1, 1, 13, 24, 0)
    dot_count = 0


# collision
const DIR_LEFT  = 0
const DIR_RIGHT = 1
const DIR_UP    = 2
const DIR_DOWN  = 3

func check_collision(x, y, dir) int:
    dot(x, y)
    if level_get_tile(x, y) != '0': return 0
    if dir == DIR_LEFT:  return TS - (x % TS)
    if dir == DIR_RIGHT: return -1 - (x % TS)
    if dir == DIR_UP:    return TS - (y % TS)
    if dir == DIR_DOWN:  return -1 - (y % TS)

func check_collision_down(x, y, py) int:
    dot(x, y)
    var t = level_get_tile(x, y)
    if (t == '0' or
        t == '^' and (y / TS) > (py / TS)):
        return -1 - (y % TS)
    return 0


const HERO_STATE_DEAD   = 0
const HERO_STATE_NORMAL = 1
const HERO_STATE_DYING  = 2

struct Hero:
    state
    sx
    sy
    vx
    vy
    box: Box

    facing_left
    on_ground

    lives
    score
    frame
    run_tick
    shoot_countdown
    hit_countdown

var hero: Hero

func camera_update():
    camera.x = hero.sx / SP - SCREEN_W / 2
    camera.y = hero.sy / SP - SCREEN_H / 2
    camera.x = clamp(camera.x, 0, level.w * TS - SCREEN_W)
    camera.y = clamp(camera.y, 0, level.h * TS - SCREEN_H)


include "particle.toy"
include "enemy.toy"


# bullet

struct Bullet:
    alive
    x
    y
    dx

var bullets: Bullet[8]

func bullet_new(x, y, dx):
    for b in bullets:
        if b.alive: continue
        b.alive = true
        b.x = x
        b.y = y
        b.dx = dx
        return

func bullet_update_all():

    var view = camera
    box_grow(view, 8)

    for b in bullets:
        if not b.alive: continue
        b.x += b.dx * 5 # speed

        if not box_has_point(view, b.x, b.y):
            b.alive = 0

        var dir = b.dx > 0 ? DIR_RIGHT : DIR_LEFT
        var o = check_collision(b.x, b.y, dir)
        if o:
            b.alive = false
            particle_spawn(PARTICLE_TYPE_FLASH, b.x + o, b.y)
            continue

        for e in enemies:
            if not e.state: continue
            if box_has_point(e.box, b.x, b.y):
                b.alive = false
                enemy_hit(e)
                particle_spawn(PARTICLE_TYPE_DEBRIS, b.x, b.y)
                particle_spawn(PARTICLE_TYPE_DEBRIS, b.x, b.y)
                continue



func bullet_draw_all():
    for b in bullets:
        if not b.alive: continue
        camera_sprite(b.x - (b.dx > 0 ? 5 : 0), b.y, 6, 1,
                      0, 176, 0)



# hero

func hero_place_at_start():
    var i = stridx(level.data, 'h')
    hero.state = HERO_STATE_NORMAL
    hero.sx = i % level.w * TS * SP
    hero.sy = i / level.w * TS * SP + SP - 1
    hero.vx = 0
    hero.vy = 0
    hero.facing_left = false
    hero.on_ground = false
    hero.shoot_countdown = 0
    hero.hit_countdown = 0
    hero.frame = 0
    hero.run_tick = 0
    entity_update_box_pos(hero.sx, hero.sy, hero.box)

func hero_init():
    hero = {}
    hero.box.w = 6
    hero.box.h = 11
    hero.lives = 3
    hero_place_at_start()


func hero_kill():
    if hero.state != HERO_STATE_NORMAL: return
    hero.state = HERO_STATE_DYING
    hero.hit_countdown = 20
    hero.vx = 0
    hero.vy = 0


const RUN_MAX      = 20
const ACCEL_GROUND = 5
const ACCEL_AIR    = 2
const JUMP_FORCE   = 48



func hero_update():
    if hero.state == HERO_STATE_DEAD:
        if hero.hit_countdown > 0: hero.hit_countdown -= 1
        else:
            if hero.lives == 0:
                # game over
                game.state = GAME_STATE_GAME_OVER
            else:
                # respawn
                hero_place_at_start()
        return


    if hero.state == HERO_STATE_DYING:
        if hero.hit_countdown > 5:
            particle_spawn(PARTICLE_TYPE_DEBRIS,
                            rand(hero.box.x, hero.box.x + hero.box.w - 1),
                            rand(hero.box.y, hero.box.y + hero.box.h - 1))

        hero.sy += hero.vy
        if hero.hit_countdown > 0: hero.hit_countdown -= 1
        else:
            hero.lives -= 1
            hero.state = HERO_STATE_DEAD
            hero.hit_countdown = 60
        return


    # horizontal movement
    var dx = btn(BTN_RIGHT) - btn(BTN_LEFT)
    if dx: hero.facing_left = dx < 0
    var accel = hero.on_ground ? ACCEL_GROUND : ACCEL_AIR
    hero.vx = clamp(RUN_MAX * dx, hero.vx - accel, hero.vx + accel)
    hero.sx += hero.vx

    var x = hero.sx / SP
    var y = hero.sy / SP

    # horizontal collision
    var o
    o = max(check_collision(x + 6, y +  7, DIR_LEFT),
            check_collision(x + 4, y + 13, DIR_LEFT))
    if o:
        x += o
        hero.sx = x * SP
        hero.vx = 0
    o = min(check_collision(x + 9, y +  7, DIR_RIGHT),
            check_collision(x + 11, y + 13, DIR_RIGHT))
    if o:
        x += o
        hero.sx = x * SP
        if hero.vx > 0: hero.sx += SP - 1
        hero.vx = 0


    # jump
    if hero.on_ground and btnp(BTN_A): hero.vy = -JUMP_FORCE
    elif not btn(BTN_A) and hero.vy < -10: hero.vy = -10

    # gravity
    # hero.vy = (btn(BTN_DOWN) - btn(BTN_UP)) * SP
    hero.vy += GRAVITY
    hero.vy = min(hero.vy, SP * 4)

    # floor collision
    var py = hero.sy / SP
    hero.sy += hero.vy
    y = hero.sy / SP
    o = min(check_collision_down(x +  5, y + 15, py + 15),
            check_collision_down(x + 10, y + 15, py + 15))
    if o:
        hero.on_ground = true
        y += o
        hero.sy = y * SP + SP - 1
        hero.vy = 0
    else:
        hero.on_ground = false

    # ceiling collision
    o = check_collision(x + 8 - hero.facing_left, y + 5, DIR_UP)
    if o:
        y += o
        hero.sy = y * SP
        hero.vy = 8


    # shoot
    if hero.shoot_countdown > 0:
        hero.shoot_countdown -= 1
    elif btn(BTN_B):
        hero.shoot_countdown = 12
        if hero.facing_left:
            bullet_new(x + 4, y + 9, -1)
        else:
            bullet_new(x + 11, y + 9, 1)


    # animation
    hero.frame = 0
    if not hero.on_ground:
        hero.frame = 4
    elif dx:
        hero.frame = 1 + hero.run_tick / 4 % 4
        hero.run_tick += 1
    else:
        hero.run_tick = 4
        hero.frame = 0

    entity_update_box_pos(hero.sx, hero.sy, hero.box)

    # check enemies
    for e in enemies:
        if not e.active: continue
        if e.state != ENEMY_STATE_NORMAL: continue
        if box_intersects(hero.box, e.box):
            enemy_hit(e)
            hero_kill()
            return

    var t = level_get_tile(hero.box.x, hero.box.y)
    # lava
    if t == 'l':
        hero_kill()
        hero.vy = 4
        return

    # level complete
    if t == 'E':


func hero_draw():
    if hero.state == HERO_STATE_DEAD: return
    if hero.state == HERO_STATE_DYING and hero.hit_countdown & 2: return

    var x = hero.sx / SP
    var y = hero.sy / SP

    var row = 0
    if hero.state == HERO_STATE_DYING: row = 2
    elif hero.shoot_countdown > 1: row = 1

    camera_sprite(x, y, 16, 16,
                  hero.frame * 16,
                  128 + row * 16,
                  hero.facing_left)



###############################################################################



# func draw_blend(v):
#     for r = 0, 12:
#         var h = clamp(v - r * 3, 0, 16)
#         for c = 0, 20: sprite(c * 16, r * 16, 16, h, 0, 32, 0)

func game_init():
    game.state = GAME_STATE_PLAY
    level_init(LEVEL1_DATA)
    hero_init()
    enemy_init_all()


func game_update():
    if game.state == GAME_STATE_GAME_OVER:

        # restart game
        if btnp(BTN_A):
            game_init()



    level_update()

    if game.state == GAME_STATE_PLAY:
        hero_update()
    camera_update()

    enemy_update_all()
    bullet_update_all()
    particle_update_all()


func game_draw():
    level_draw_background()
    enemy_draw_all()

    if game.state == GAME_STATE_PLAY:
        hero_draw()

    bullet_draw_all()
    particle_draw_all()
    level_draw_walls()

    draw_dots()

    # HUD
    # lives
    strnum(str, hero.lives)
    draw_text(0, SCREEN_H - 8, str)
    # score
    strnum(str, hero.score)
    draw_text(SCREEN_W - strlen(str) * 8, SCREEN_H - 8, str)

    if game.state == GAME_STATE_GAME_OVER:
        draw_centered_text(SCREEN_W/2, SCREEN_H/2 - 4, "GAME OVER")
