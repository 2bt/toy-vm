func skip_space(p: int**):
    while p.*.* == ' ' or p.*.* == '\n': p.* += 1

func skip_line(p: int**):
    while p.*.* and p.*.* != '\n': p.* += 1
    if p.*.*: p.* += 1

func isdigit(c) int:
    return c >= '0' and c <= '9'

func read_num(p: int**) int:
    var n = 0
    var minus = false
    while p.*.* == '-':
        minus = not minus
        p.* += 1
    while isdigit(p.*.*):
        n = n * 10 + p.*.* - '0'
        p.* += 1
    skip_space(p)
    return minus ? -n : n


struct InstrStream:
    pos: int*
    loop: int*
    wait

struct NoteStream:
    voice_index
    pos: int*
    loop: int*

    skip
    octave
    next_note
    next_wait
    next_instr
    next_quant
    next_volume
    next_porta

    quant
    volume
    porta
    pitch
    porta_pitch

    wait
    env
    level

    instr_stream: InstrStream

    attack
    decay
    sustain
    release
    wave
    pitch_offset
    abs_pitch
    pw
    pw_rate

    vib_pos
    vib_rate
    vib_depth



var instruments: int*[32]
var note_streams: NoteStream[4]


func music_play(music: int*):
    for n in instruments: n.* = null
    for s in note_streams:
        s.* = {}
        s.next_note = NOTE_OFF
    var c
    var i
    var p = music
    while p.*:
        c = p.*
        p += 1
        if c == '#': skip_line(p)
        elif c == '$':
            i = read_num(p)
            if i < instruments.len: instruments[i] = p
        elif c == '@':
            i = read_num(p)
            if i < note_streams.len and not note_streams[i].pos:
                note_streams[i].voice_index = i
                note_streams[i].pos         = p


const NOTE_EMPTY = -1
const NOTE_OFF   = -2

const ENV_RELEASE = 0
const ENV_ATTACK  = 1
const ENV_DECAY   = 2
const ENV_PEAK    = 256 * 64

func env_step(rate) int: return ENV_PEAK / (1 + (rate + 8) * rate * 15 / 128)

func music_read_row(v: NoteStream*) int:
    if not v.pos: return false
    v.next_note  = NOTE_EMPTY
    v.next_porta = 0

    while v.pos:
        if v.skip:
            while v.pos.* and v.pos.* != '@': v.pos += 1
            if not v.pos.*:
                v.skip = false
                v.pos = v.loop
                continue
            v.pos += 1
            if read_num(v.pos) != v.voice_index: continue
            v.skip = false
        var c = v.pos.*
        if c == '\0':
            v.pos = v.loop
            continue
        v.pos += 1
        if   c == ' ' or c == '\n':
        elif c == '|': v.loop = v.pos
        elif c == '#': skip_line(v.pos)
        elif c == ',': break
        elif c == 'v': v.next_volume = read_num(v.pos)
        elif c == 't': v.next_wait   = read_num(v.pos)
        elif c == 'i': v.next_instr  = read_num(v.pos)
        elif c == 'q': v.next_quant  = read_num(v.pos)
        elif c == '*': v.next_porta  = read_num(v.pos)
        elif c == 'o': v.octave      = read_num(v.pos)
        elif c == '<': v.octave -= 1
        elif c == '>': v.octave += 1
        elif c == '+': v.next_note += 1
        elif c == '-': v.next_note -= 1
        elif c == '=': v.next_note = NOTE_OFF
        elif c >= 'a' and c <= 'g': v.next_note = stridx("c d ef g a b", c) + 12 * v.octave
        else: v.skip = true
    return true



func music_update():
    for v in note_streams:
        if not v.pos: continue

        if v.wait == v.quant:
            if v.next_note != NOTE_EMPTY and v.next_porta == 0: v.env = ENV_RELEASE
        if v.wait <= 0:
            v.wait = v.next_wait
            if v.next_note >= 0:
                v.porta_pitch = v.next_note * 8
                if v.next_porta == 0:
                    v.pitch        = v.porta_pitch
                    v.env          = ENV_ATTACK
                    v.level        = 0
                    v.vib_pos      = 0
                    v.instr_stream = { instruments[v.next_instr] }
            v.quant  = v.next_quant
            v.volume = v.next_volume
            v.porta  = v.next_porta
            if not music_read_row(v): continue
        v.wait -= 1


        # instrument
        var s = &v.instr_stream
        if s.pos and s.wait <= 0:
            while s.pos.*:
                var c = s.pos.*
                s.pos += 1
                if   c == ' ':
                elif c == 'a': v.attack    = env_step(read_num(s.pos))
                elif c == 'd': v.decay     = ENV_PEAK - env_step(read_num(s.pos))
                elif c == 'r': v.release   = ENV_PEAK - env_step(read_num(s.pos))
                elif c == 's': v.sustain   = read_num(s.pos) * ENV_PEAK / 64
                elif c == 'W': v.pw        = read_num(s.pos)
                elif c == 'w': v.pw_rate   = read_num(s.pos)
                elif c == 'V': v.vib_depth = read_num(s.pos)
                elif c == 'v': v.vib_rate  = read_num(s.pos)
                elif c == 'T': v.wave      = WAVE_TRI
                elif c == 'S': v.wave      = WAVE_SAW
                elif c == 'P': v.wave      = WAVE_PULSE
                elif c == 'N': v.wave      = WAVE_NOISE
                elif c == '=' or c == '~':
                    v.pitch_offset = read_num(s.pos) * 8
                    v.abs_pitch    = c == '='
                elif c == '|': s.loop = s.pos
                elif c == ',':
                    s.wait = max(1, read_num(s.pos)) -1
                    break
                else:
                    s.pos = s.loop
                    if not s.pos:
                        break

        # adsr (separate ifs so instant attack can enter decay same frame)
        if v.env == ENV_ATTACK:
            v.level = min(v.level + v.attack, ENV_PEAK)
            if v.level == ENV_PEAK: v.env = ENV_DECAY
        if v.env == ENV_DECAY: v.level = v.sustain + (v.level - v.sustain) * v.decay / ENV_PEAK
        if v.env == ENV_RELEASE: v.level = v.level * v.release / ENV_PEAK

        # portamento
        if v.pitch != v.porta_pitch:
            v.pitch = clamp(v.porta_pitch, v.pitch - v.porta, v.pitch + v.porta)

        var pitch = v.pitch_offset
        if not v.abs_pitch: pitch += v.pitch

        if v.vib_depth:
            var x = v.vib_pos % 128
            if x > 64: x = 128 - x
            if v.vib_pos >= 128: x = -x
            pitch += x * v.vib_depth / 64

        sound(v.voice_index + 4, pitch, v.pw, v.volume * v.level / ENV_PEAK, v.wave)

        # pw sweep
        v.pw += v.pw_rate
        v.pw %= 256

        # vib
        v.vib_pos += v.vib_rate
        v.vib_pos %= 256
