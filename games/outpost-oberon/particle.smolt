const PARTICLE_TYPE_DEBRIS    = 1
const PARTICLE_TYPE_FLASH     = 2
const PARTICLE_TYPE_CHARGE    = 3
const PARTICLE_TYPE_EXPLOSION = 4


struct Particle:
    ttl
    type
    sx
    sy
    vx
    vy
    flip

var particles: Particle[200]

func particle_spawn(type, x, y) Particle*:
    for p in particles:
        if p.ttl == 0:
            p.* = {}
            p.type = type
            p.sx   = x * SP
            p.sy   = y * SP

            if type == PARTICLE_TYPE_DEBRIS:
                p.ttl  = rand(5, 60)
                p.vx   = rand(-15, 15)
                p.vy   = rand(-25, 0)
                p.flip = rand(0, 3)

            elif type == PARTICLE_TYPE_FLASH:
                p.ttl = 3

            elif type == PARTICLE_TYPE_CHARGE:
                p.ttl = 10

            elif type == PARTICLE_TYPE_EXPLOSION:
                p.ttl = 2

            return p
    return null


func particle_update_all():
    for p in particles:
        if p.ttl == 0: continue
        p.ttl  -= 1

        if p.type == PARTICLE_TYPE_DEBRIS:
            p.sx += p.vx
            var o = level_test(p.sx / SP, p.sy / SP, p.vx > 0 ? DIR_RIGHT : DIR_LEFT)
            if o:
                p.sx += o * SP
                p.vx *= -1

            p.vy += GRAVITY / 2
            p.sy += p.vy

            o = level_test(p.sx / SP, p.sy / SP, p.vy > 0 ? DIR_DOWN : DIR_UP)
            if o:
                p.sy += o * SP
                p.vy *= -7
                p.vy /= 10


func particle_draw_all():
    for p in particles:
        if p.ttl == 0: continue


        var x = p.sx / SP
        var y = p.sy / SP

        if p.type == PARTICLE_TYPE_DEBRIS:
            var frame = max(0, 9 - p.ttl / 8)
            camera_sprite(x - 2, y - 2, 5, 5,
                          frame * 8,
                          256,
                          p.flip)

        elif p.type == PARTICLE_TYPE_FLASH:
            camera_sprite(x - 2, y - 2, 5, 5,
                          0,
                          256 + 16,
                          0)

        elif p.type == PARTICLE_TYPE_CHARGE:
            camera_sprite(x - 4, y - 4, 9, 9,
                          clamp(10 - p.ttl, 0, 5) * 16,
                          256 + 32,
                          0)

        elif p.type == PARTICLE_TYPE_EXPLOSION:
            camera_sprite(x - 9, y - 9, 18, 18, 0, 304, 0)
