const ENEMY_STATE_DEAD   = 0
const ENEMY_STATE_NORMAL = 1
const ENEMY_STATE_DYING  = 2

const ENEMY_TYPE_PATROL  = 1
const ENEMY_TYPE_BUGGER  = 2
const ENEMY_TYPE_CANNON  = 3
const ENEMY_TYPE_JELLY   = 4

const ENEMY_BULLET_TYPE_BASIC = 1
const ENEMY_BULLET_TYPE_AIMED = 2


# ---------------------------------------------------------------------------
# bullets
# ---------------------------------------------------------------------------

struct EnemyBullet:
    alive
    type
    box: Box
    sx
    sy
    vx
    vy

var enemy_bullets: EnemyBullet[16]

# x,y = top-left of hit box
func enemy_bullet_spawn(type, x, y) EnemyBullet*:
    for b in enemy_bullets:
        if b.alive: continue
        b.* = {}
        b.alive = true
        b.type = type
        if type == ENEMY_BULLET_TYPE_BASIC:
            b.box.w = 6
            b.box.h = 1
        else:
            b.box.w = 2
            b.box.h = 2
        b.box.x = x
        b.box.y = y
        b.sx = x * SP
        b.sy = y * SP
        return b
    return null

func enemy_bullet_update_all():
    var view = camera.box
    box_grow(view, 8)

    for b in enemy_bullets:
        if not b.alive: continue
        if not box_intersects(view, b.box):
            b.alive = 0
            continue

        var hit_x = level_move_box_x(&b.sx, &b.box, b.vx)
        var hit_y = level_move_box_y(&b.sy, &b.box, b.vy)
        if hit_x or hit_y:
            b.alive = false
            var px = box_center_x(b.box)
            var py = box_center_y(b.box)
            if hit_x == DIR_LEFT:  px = b.box.x
            if hit_x == DIR_RIGHT: px = b.box.x + b.box.w - 1
            if hit_y == DIR_UP:    py = b.box.y
            if hit_y == DIR_DOWN:  py = b.box.y + b.box.h - 1
            particle_spawn(PARTICLE_TYPE_FLASH, px, py)
            sfx_play(SFX_BULLET_WALL)
            continue

        if hero_can_take_damage() and box_intersects(b.box, hero.box):
            b.alive = false
            hero_set_state(HERO_STATE_DYING)
            continue

func enemy_bullet_draw_all():
    for b in enemy_bullets:
        if not b.alive: continue
        if b.type == ENEMY_BULLET_TYPE_BASIC:
            camera_sprite(b.box.x, b.box.y, 6, 1, 0, 32 + 1, 0)
        elif b.type == ENEMY_BULLET_TYPE_AIMED:
            for i = 0, 4:
                var x = (b.sx - b.vx * i) / SP - 1
                var y = (b.sy - b.vy * i) / SP - 1
                camera_sprite(x, y, 4, 4, 272, 112, 0)

# ---------------------------------------------------------------------------
# enemies
# ---------------------------------------------------------------------------

struct Enemy:
    state
    active
    box: Box
    type
    sx
    sy
    hp

    facing_left
    frame
    hit_countdown

    # movement (bugger; patrol leaves unused)
    mode
    vx
    vy
    on_ground
    ground_frames
    no_turn_countdown

    # patrol / bugger timers (bugger: wait = sleep / turn / land pause;
    # pace = loc-lost / stroll)
    anim_tick
    wait_countdown
    wait_turn
    pace_countdown
    shoot_countdown
    burst_left
    aim_countdown

    # jelly
    home_sy
    charge: Particle*

var enemies: Enemy[64]


func enemy_init_all():
    for e in enemies: e.* = {}
    for r = 0, level.h:
        for c = 0, level.w:
            var x = c * TS
            var y = r * TS
            var t = level_get_tile_at_cr(c, r)
            if   t == 'p': enemy_spawn(ENEMY_TYPE_PATROL, x, y)
            elif t == 'b': enemy_spawn(ENEMY_TYPE_BUGGER, x, y)
            elif t == 'c': enemy_spawn(ENEMY_TYPE_CANNON, x, y)
            elif t == 'j': enemy_spawn(ENEMY_TYPE_JELLY, x, y)

func enemy_spawn(type, x, y):
    for e in enemies:
        if e.state: continue
        e.* = {}
        e.state = ENEMY_STATE_NORMAL
        e.type  = type

        if type == ENEMY_TYPE_PATROL:
            e.box.w           = 8
            e.box.h           = 17
            e.hp              = 2
            e.pace_countdown  = rand(30, 80)
            e.shoot_countdown = rand(0, 100)

        elif type == ENEMY_TYPE_BUGGER:
            e.box.w     = 12
            e.box.h     = 11
            e.hp        = 2
            enemy_bugger_set_mode(e, BUGGER_MODE_SLEEP)

        elif type == ENEMY_TYPE_CANNON:
            e.box.w = 5
            e.box.h = 12
            e.hp    = 3
            e.facing_left = level_get_tile_at_cr(x / TS + 1, y / TS) == '0'
            e.shoot_countdown = rand(30, 90)

        elif type == ENEMY_TYPE_JELLY:
            e.box.w = 10
            e.box.h = 10
            e.hp    = 1
            e.vx    = 1
            e.vy    = JELLY_SPEED
            e.shoot_countdown = rand(40, 100)


        e.sx = (x + 8 - e.box.w / 2) * SP
        e.sy = (y + 16 - e.box.h) * SP + SP - 1

        if type == ENEMY_TYPE_CANNON:
            e.sy = (y + 8 - e.box.h / 2) * SP
            if e.facing_left: e.sx += 5 * SP
            else:             e.sx -= 6 * SP

        if type == ENEMY_TYPE_JELLY:
            e.sy = (y + 8 - e.box.h / 2) * SP

        e.box.x = e.sx / SP
        e.box.y = e.sy / SP
        return

    print("enemy spawn error")



func enemy_update_all():
    var view = camera.box
    box_grow(view, 32)

    for e in enemies:
        if e.state == ENEMY_STATE_DEAD: continue

        if e.state == ENEMY_STATE_DYING:
            e.sx += e.vx
            e.sy += e.vy
            e.box.x = e.sx / SP
            e.box.y = e.sy / SP

            if e.hit_countdown > 5:
                particle_spawn(PARTICLE_TYPE_DEBRIS,
                               rand(e.box.x, e.box.x + e.box.w - 1),
                               rand(e.box.y, e.box.y + e.box.h - 1))

            if e.hit_countdown > 0: e.hit_countdown -= 1
            else:
                e.state  = ENEMY_STATE_DEAD
                e.active = false

                # scoring
                hero.score += (
                    e.type == ENEMY_TYPE_PATROL ? 100 :
                    e.type == ENEMY_TYPE_BUGGER ? 150 :
                    e.type == ENEMY_TYPE_CANNON ? 125 :
                    e.type == ENEMY_TYPE_JELLY  ? 200 :
                    0)

            continue

        if e.state != ENEMY_STATE_NORMAL: continue


        var prev_active = e.active
        e.active = box_intersects(view, e.box)
        if e.active and not prev_active and e.type != ENEMY_TYPE_CANNON:
            e.facing_left = e.sx > hero.sx

        if e.hit_countdown > 0: e.hit_countdown -= 1

        if   e.type == ENEMY_TYPE_PATROL: enemy_patrol_update(e)
        elif e.type == ENEMY_TYPE_BUGGER: enemy_bugger_update(e)
        elif e.type == ENEMY_TYPE_CANNON: enemy_cannon_update(e)
        elif e.type == ENEMY_TYPE_JELLY:  enemy_jelly_update(e)


func enemy_draw_all():
    for e in enemies:
        if not e.active: continue

        if e.state == ENEMY_STATE_DYING and e.hit_countdown & 2: continue

        if e.type == ENEMY_TYPE_PATROL:
            camera_sprite(e.box.x - 4, e.box.y - 15, 16, 32,
                          256 + e.frame * 16,
                          0 + (e.hit_countdown > 0) * 32,
                          e.facing_left)

        elif e.type == ENEMY_TYPE_BUGGER:
            camera_sprite(e.box.x - 2, e.box.y - 5, 16, 16,
                          256 + e.frame * 16,
                          80 + (e.hit_countdown > 0) * 16,
                          e.facing_left)

        elif e.type == ENEMY_TYPE_CANNON:
            var cx = e.facing_left ? e.box.x - 11 : e.box.x
            camera_sprite(cx, e.box.y - 2, 16, 16,
                          256,
                          112 + (e.hit_countdown > 0) * 16,
                          e.facing_left)

        elif e.type == ENEMY_TYPE_JELLY:
            camera_sprite(e.box.x - 3, e.box.y - 3, 16, 16,
                          256 + e.frame * 16,
                          144 + (e.hit_countdown > 0) * 16,
                          0)

        # box
        # camera_sprite(e.box.x, e.box.y, e.box.w, e.box.h, 0, 480, 0)


func enemy_hit(e: Enemy*):
    if e.state != ENEMY_STATE_NORMAL: return
    e.hp -= 1
    e.hit_countdown = 3

    if e.type == ENEMY_TYPE_PATROL:
        if e.aim_countdown == 0:
            e.shoot_countdown /= 2
            if e.facing_left != (box_center_x(e.box) > box_center_x(hero.box)):
                e.wait_countdown = min(10, e.shoot_countdown)
                e.wait_turn      = true

    elif e.type == ENEMY_TYPE_BUGGER:
        enemy_bugger_set_mode(e, BUGGER_MODE_FOLLOW)

    if e.hp <= 0: enemy_kill(e)
    else: sfx_play(SFX_ENEMY_HIT)


func enemy_kill(e: Enemy*):
    e.state = ENEMY_STATE_DYING
    e.hit_countdown = 20
    e.vx = 0
    e.vy = 0
    sfx_play(SFX_EXPLOSION)



# ---------------------------------------------------------------------------
# patrol
# ---------------------------------------------------------------------------

func enemy_patrol_update(e: Enemy*):
    if e.aim_countdown > 0:
        e.frame = 0
    elif e.wait_countdown > 0:
        e.wait_countdown -= 1
        if e.wait_countdown == 0:
            if e.wait_turn: e.facing_left = not e.facing_left
            e.pace_countdown = rand(30, 180)
        e.frame = 0
    else:

        # walk
        var dx = e.facing_left ? -6 : 6
        var hit = level_move_box_x(e.sx, e.box, dx)

        var face_x = e.facing_left ? e.box.x : e.box.x + e.box.w - 1
        var foot_y = e.box.y + e.box.h
        var turn = -1
        if hit or not level_test_down(face_x, foot_y, foot_y - 1):
            turn = 1
        else:
            e.anim_tick += 1
            e.frame = 1 + e.anim_tick / 6 % 4
            e.pace_countdown -= 1
            if e.pace_countdown == 0: turn = rand(0, 4) == 0
        if turn >= 0:
            e.wait_countdown = rand(50, 90)
            e.wait_turn = turn > 0
            e.frame = 0

    e.box.x = e.sx / SP
    e.box.y = e.sy / SP


    var muzzle_x = e.facing_left ? e.box.x - 2 : e.box.x + e.box.w + 1
    var muzzle_y = e.box.y + 7
    if e.aim_countdown > 0:
        e.aim_countdown -= 1
        if e.aim_countdown == 19:
            sfx_play(SFX_CHARGE)
            particle_spawn(PARTICLE_TYPE_CHARGE, muzzle_x, muzzle_y)
        if e.aim_countdown == 5:
            var bx = e.facing_left ? muzzle_x : muzzle_x - 5
            var b = enemy_bullet_spawn(ENEMY_BULLET_TYPE_BASIC, bx, muzzle_y)
            if b:
                b.vx = e.facing_left ? -28 : 28
                sfx_play(SFX_PATROL_SHOOT)

        if e.aim_countdown == 0:
            e.burst_left -= 1
            if e.burst_left > 0: e.aim_countdown = 30
            else:
                e.shoot_countdown = rand(60, 200)
                e.burst_left = rand(1, 2)

    elif e.shoot_countdown > 0:
        e.shoot_countdown -= 1

    elif hero.state == HERO_STATE_NORMAL:
        var ex = box_center_x(e.box)
        var ey = box_center_y(e.box)
        var hx = box_center_x(hero.box)
        var hy = box_center_y(hero.box)

        if (e.facing_left == (hx < ex)
        and abs(hy - ey) <= 70
        and box_encloses(camera.box, e.box)
        and (level_has_los(ex, ey, hx, hy) or level_has_los(ex, ey, hx, ey))):
            e.aim_countdown = 20
        else:
            e.shoot_countdown = rand(30, 150)
            e.burst_left = rand(1, 2)


# ---------------------------------------------------------------------------
# bugger
# ---------------------------------------------------------------------------
const BUGGER_MODE_SLEEP  = 0
const BUGGER_MODE_FOLLOW = 1
const BUGGER_MODE_WALK   = 2

const BUGGER_SPEED           = 14
const BUGGER_WALK_SPEED      = 7
const BUGGER_ACCEL           = 1
const BUGGER_WAKE_FRAMES     = 50
const BUGGER_LOC_LOST_FRAMES = 180


func enemy_bugger_set_mode(e: Enemy*, mode):
    e.mode = mode
    e.wait_countdown = 0
    if mode == BUGGER_MODE_SLEEP:
        e.pace_countdown = BUGGER_WAKE_FRAMES
    elif mode == BUGGER_MODE_FOLLOW:
        e.facing_left = box_center_x(e.box) > box_center_x(hero.box)
        e.pace_countdown = BUGGER_LOC_LOST_FRAMES
    elif mode == BUGGER_MODE_WALK:
        e.pace_countdown = rand(60 * 5, 60 * 10)


func enemy_bugger_has_loc(e: Enemy*) int:
    if hero.state != HERO_STATE_NORMAL: return 0
    if not box_encloses(camera.box, e.box): return 0
    var ex = box_center_x(e.box)
    var ey = box_center_y(e.box)
    var hx = box_center_x(hero.box)
    var hy = box_center_y(hero.box)
    return level_has_los(ex, ey, hx, hy)


func enemy_bugger_update(e: Enemy*):

    var hx = box_center_x(hero.box)
    var hy = box_center_y(hero.box)

    var ex = box_center_x(e.box)
    var ey = box_center_y(e.box)
    var loc = enemy_bugger_has_loc(e)

    if e.mode == BUGGER_MODE_SLEEP:
        if loc:
            e.pace_countdown -= 1
            if e.pace_countdown == 0:
                enemy_bugger_set_mode(e, BUGGER_MODE_FOLLOW)
        else:
            e.pace_countdown = BUGGER_WAKE_FRAMES

    elif e.mode == BUGGER_MODE_FOLLOW:
        if hero.state != HERO_STATE_NORMAL:
            enemy_bugger_set_mode(e, BUGGER_MODE_WALK)
        elif loc:
            e.pace_countdown = BUGGER_LOC_LOST_FRAMES
        else:
            e.pace_countdown -= 1
            if e.pace_countdown == 0:
                enemy_bugger_set_mode(e, BUGGER_MODE_WALK)

    elif e.mode == BUGGER_MODE_WALK:
        if loc:
            enemy_bugger_set_mode(e, BUGGER_MODE_FOLLOW)
        else:
            e.pace_countdown -= 1
            if e.pace_countdown == 0:
                enemy_bugger_set_mode(e, BUGGER_MODE_SLEEP)



    if e.no_turn_countdown > 0: e.no_turn_countdown -= 1
    if e.wait_countdown > 0:
        e.wait_countdown -= 1
        if e.wait_countdown == 0 and e.wait_turn: e.facing_left = not e.facing_left

    if e.on_ground:

        var speed  = 0
        var jump   = 0
        var foot_y = e.box.y + e.box.h
        var foot_x = e.facing_left ? e.box.x : e.box.x + e.box.w - 1


        if e.wait_countdown:
        elif e.mode == BUGGER_MODE_WALK:
            speed = BUGGER_WALK_SPEED
            # turn around on ledge
            if not level_test_down(foot_x, foot_y, foot_y - 1):
                e.wait_countdown = 20
                e.wait_turn      = true

        elif e.mode == BUGGER_MODE_FOLLOW:
            speed = BUGGER_SPEED

            # turn around to hero
            var want_left = hx < ex
            if e.no_turn_countdown <= 0 and want_left != e.facing_left and loc:
                e.wait_countdown = 20
                e.wait_turn      = true

            if e.ground_frames > 15:
                if abs(hx - ex) <= 35 and hero.box.y < ey:
                    # attack
                    jump = 38
                elif abs(e.vx) > BUGGER_SPEED - 3:
                    var wall_x = e.facing_left ? e.box.x - 10 : e.box.x + e.box.w - 1 + 10
                    if want_left == e.facing_left and level_test(wall_x, e.box.y, 0):
                        jump = 38
                    elif not level_test_down(foot_x, foot_y, foot_y - 1):
                        jump = 24
                if jump:
                    e.vy = -jump
                    e.on_ground = false
                    e.ground_frames = 0
                    sfx_play(SFX_BUGGER_JUMP)

        e.vx = clamp(e.facing_left ? -speed : speed, e.vx - BUGGER_ACCEL, e.vx + BUGGER_ACCEL)

        e.ground_frames += 1
    else:
        e.ground_frames = 0


    if level_move_box_x(e.sx, e.box, e.vx):
        if e.on_ground:
            if e.mode == BUGGER_MODE_WALK:
                e.wait_countdown = 20
                e.wait_turn      = true
            else:
                # walk away from the wall
                e.facing_left = e.vx > 0
                e.no_turn_countdown = 30
            e.vx = 0
        else:
            e.vx = -e.vx

    e.vy += GRAVITY
    e.vy = min(e.vy, SP * 4)
    e.on_ground = false
    var d = level_move_box_y(e.sy, e.box, e.vy)
    if d == DIR_DOWN:
        e.on_ground = true
        e.vy = 0
    elif d == DIR_UP:
        e.vy = 8

    var t = level_get_tile(e.box.x, e.box.y)
    if t == 'l':
        enemy_kill(e)
        e.vy = 4

    # animation
    if not e.on_ground:
        e.frame = e.vy < 0 ? 5 : 6
        if abs(e.vy) < 10: e.frame = 4
    elif e.mode == BUGGER_MODE_SLEEP: e.frame = 7
    elif e.wait_countdown > 0: e.frame = 0
    else:
        e.anim_tick += 1
        var rate = e.mode == BUGGER_MODE_WALK ? 8 : 4
        e.frame = 1 + e.anim_tick / rate % 4


# ---------------------------------------------------------------------------
# cannon
# ---------------------------------------------------------------------------
const AIMED_BULLET_SPEED  = 18
const CANNON_LOS_LATCH    = 25
const CANNON_BURST_FRAMES = 60

func enemy_cannon_update(e: Enemy*):
    var mx = e.facing_left ? e.box.x : e.box.x + e.box.w - 1
    var my = box_center_y(e.box)
    var hx = box_center_x(hero.box)
    var hy = box_center_y(hero.box)
    var loc = (hero.state == HERO_STATE_NORMAL
        and box_encloses(camera.box, e.box)
        and level_has_los(mx, my, hx, hy))

    if e.aim_countdown > 0:
        if e.aim_countdown == 60 or e.aim_countdown == 40 or e.aim_countdown == 20:
            particle_spawn(PARTICLE_TYPE_CHARGE, mx, my)
        if e.aim_countdown == 55 or e.aim_countdown == 35 or e.aim_countdown == 15:
            var dx = hx - mx
            var dy = hy - my
            var len = sqrt(dx * dx + dy * dy)
            if len < 1: len = 1
            var b = enemy_bullet_spawn(ENEMY_BULLET_TYPE_AIMED, mx - 1, my - 1)
            if b:
                b.vx = dx * AIMED_BULLET_SPEED / len
                b.vy = dy * AIMED_BULLET_SPEED / len
                sfx_play(SFX_CANNON_SHOOT)
        e.aim_countdown -= 1
        if e.aim_countdown == 0:
            e.shoot_countdown = 120
            e.pace_countdown = 0

    elif e.shoot_countdown > 0:
        e.shoot_countdown -= 1
        e.pace_countdown = 0

    elif loc:
        e.pace_countdown += 1
        if e.pace_countdown >= CANNON_LOS_LATCH:
            e.aim_countdown = CANNON_BURST_FRAMES
            e.pace_countdown = 0
    else:
        e.pace_countdown = 0


# ---------------------------------------------------------------------------
# jelly
# ---------------------------------------------------------------------------
const JELLY_AIM_FRAMES    = 25
const JELLY_COOLDOWN      = 120
const JELLY_SPEED         = 34
const JELLY_MAX_SPEED     = 10

func enemy_jelly_update(e: Enemy*):
    e.anim_tick += 1
    if e.anim_tick % 3:
        e.vy += e.vx
        if abs(e.vy) > JELLY_SPEED: e.vx = -e.vx
        e.sy += clamp(e.vy, -JELLY_MAX_SPEED, JELLY_MAX_SPEED)
        e.box.x = e.sx / SP
        e.box.y = e.sy / SP
        e.frame = e.anim_tick / 5 % 5

    var cx = box_center_x(e.box)
    var cy = box_center_y(e.box)
    var hx = box_center_x(hero.box)
    var hy = box_center_y(hero.box)
    var loc = (hero.state == HERO_STATE_NORMAL
        and box_encloses(camera.box, e.box)
        and level_has_los(cx, cy, hx, hy))

    if e.charge:
        e.charge.sx = cx * SP
        e.charge.sy = cy * SP
        if e.charge.ttl <= 0: e.charge = null

    if e.shoot_countdown > 0:
        e.shoot_countdown -= 1
        if e.shoot_countdown == 0:
            e.pace_countdown = 10
    elif e.pace_countdown > 0:
        if not loc: e.pace_countdown = 10
        else:
            e.pace_countdown -= 1
            if e.pace_countdown == 0:
                e.aim_countdown = 10
                e.charge = particle_spawn(PARTICLE_TYPE_CHARGE, cx, cy)
                sfx_play(SFX_CHARGE)

    elif e.aim_countdown > 0:
        e.aim_countdown -= 1
        if e.aim_countdown == 0:
            e.shoot_countdown = 120
            var dx = hx - cx
            var dy = hy - cy
            var len = sqrt(dx * dx + dy * dy)
            if len < 1: len = 1
            var b = enemy_bullet_spawn(ENEMY_BULLET_TYPE_AIMED, cx - 1, cy - 1)
            if b:
                b.vx = dx * AIMED_BULLET_SPEED / len
                b.vy = dy * AIMED_BULLET_SPEED / len
                sfx_play(SFX_CANNON_SHOOT)
