const WAVE_TRI   = 1
const WAVE_SAW   = 2
const WAVE_PULSE = 3
const WAVE_NOISE = 4


# sound effect commands
const SND_END       = 0
const SND_PITCH     = 100
const SND_PITCH_INC = 101
const SND_VOL       = 102  # vol = vol_target = val; vol_rate = 0
const SND_VOL_SLIDE = 103  # vol_target, vol_rate (rate: close gap*rate/64 per frame)
const SND_PW        = 104
const SND_WAVE      = 105
const SND_LOOP      = 106


struct SoundEffect:
    voice_index
    start0: int*
    start1: int*


