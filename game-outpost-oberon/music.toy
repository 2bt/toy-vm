struct InstrStream:
    pos: int*
    loop: int*
    wait

struct MusicStream:
    index
    pos: int*
    loop: int*

    octave
    next_note
    next_porta_start
    next_porta_speed

    next_wait
    next_instr
    next_quant
    next_volume

    quant
    volume
    instr_vol
    porta_speed
    pitch
    pitch_target

    wait
    env
    level

    instr_stream: InstrStream

    attack
    decay
    sustain
    release
    wave
    pitch_offset
    abs_pitch
    pw
    pw_rate

    vib_pos
    vib_rate
    vib_depth

struct Music:
    volume
    instruments: int*[99]
    streams: MusicStream[4]

var music: Music


func skip_space(p: int**):
    while p.*.* == ' ' or p.*.* == '\n': p.* += 1

func skip_line(p: int**):
    while p.*.* and p.*.* != '\n': p.* += 1
    if p.*.*: p.* += 1

func read_num(p: int**) int:
    var n = 0
    var minus = false
    while p.*.* == '-':
        minus = not minus
        p.* += 1
    while p.*.* >= '0' and p.*.* <= '9':
        n = n * 10 + p.*.* - '0'
        p.* += 1
    skip_space(p)
    return minus ? -n : n


func music_play(p: int*):
    for n in music.instruments: n.* = null
    for s in music.streams: s.* = {}
    while p.*:
        var c = p.*
        p += 1
        if c == '#': skip_line(p)
        elif c == '$':
            var i = read_num(p)
            if i < music.instruments.len: music.instruments[i] = p
        elif c == '@':
            var i = read_num(p)
            if i < music.streams.len:
                var s = &music.streams[i]
                if s.pos: continue
                s.pos         = p
                s.index       = i
                s.next_note   = NOTE_OFF
                s.next_volume = 64
                s.octave      = 4


const NOTE_EMPTY = -1
const NOTE_OFF   = -2

const ENV_RELEASE = 0
const ENV_ATTACK  = 1
const ENV_DECAY   = 2
const ENV_PEAK    = 256 * 64

func env_step(rate) int: return ENV_PEAK / (1 + (rate + 8) * rate * 15 / 128)

func music_read_row(v: MusicStream*) int:
    if not v.pos: return false
    v.next_note        = NOTE_EMPTY
    v.next_porta_start = NOTE_EMPTY
    v.next_porta_speed = 0

    while true:
        var c = v.pos.*
        v.pos += 1
        if   c == ' ' or c == '\n':
        elif c == '#': skip_line(v.pos)
        elif c == '|': v.loop = v.pos
        elif c == 'v': v.next_volume = read_num(v.pos)
        elif c == 'i': v.next_instr  = read_num(v.pos)
        elif c == 'q': v.next_quant  = read_num(v.pos)
        elif c == '*':
            v.next_porta_speed = read_num(v.pos) ?: 9999
            v.next_porta_start = v.next_note
        elif c == 'o': v.octave = read_num(v.pos)
        elif c == '<': v.octave -= 1
        elif c == '>': v.octave += 1
        elif c == '\'': v.next_note += 12
        elif c == '+': v.next_note += 1
        elif c == '-': v.next_note -= 1
        elif c == '=': v.next_note = NOTE_OFF
        elif c >= 'a' and c <= 'g': v.next_note = stridx("c d ef g a b", c) + 12 * v.octave
        elif c == 't': v.next_wait = read_num(v.pos)
        elif c == ',':
            v.next_wait = read_num(v.pos) ?: v.next_wait
            return true
        else:
            # skip
            while true:
                if c == '\0':
                    v.pos = v.loop
                    if not v.pos: return false
                    break
                if c == '@' and read_num(v.pos) == v.index: break
                if c == '#': skip_line(v.pos)
                c = v.pos.*
                v.pos += 1


func music_update():
    for v in music.streams:
        if not v.pos: continue

        if v.wait == v.quant:
            if v.next_note != NOTE_EMPTY and v.next_porta_speed == 0: v.env = ENV_RELEASE
            if v.next_note != NOTE_EMPTY and v.next_porta_speed == 0: v.env = ENV_RELEASE
        if v.wait <= 0:
            v.wait = v.next_wait

            if v.next_note >= 0:
                v.pitch_target = v.next_note * 64
                if v.next_porta_start >= 0 or v.next_porta_speed == 0:
                    v.instr_vol    = 64
                    v.pitch        = v.next_porta_start >= 0 ? v.next_porta_start * 64 : v.pitch_target
                    v.env          = ENV_ATTACK
                    v.level        = 0
                    v.instr_stream = { music.instruments[v.next_instr] }
                    v.attack       = ENV_PEAK
                    v.sustain      = 0
                    v.pitch_offset = 0
                    v.abs_pitch    = false
                    v.vib_pos      = 0
                    v.vib_rate     = 0
                    v.vib_depth    = 0
            if v.next_note != NOTE_EMPTY: v.porta_speed = v.next_porta_speed
            if v.next_note != NOTE_EMPTY: v.porta_speed = v.next_porta_speed
            v.quant  = v.next_quant
            v.volume = v.next_volume
            if not music_read_row(v): continue
        v.wait -= 1


        # instrument
        var s = &v.instr_stream
        if s.pos:
            if s.wait <= 0:
                while true:
                    var c = s.pos.*
                    s.pos += 1
                    if   c == ' ':
                    elif c == 'v': v.instr_vol = read_num(s.pos)
                    elif c == 'a': v.attack    = env_step(read_num(s.pos))
                    elif c == 'd': v.decay     = ENV_PEAK - env_step(read_num(s.pos))
                    elif c == 'r': v.release   = ENV_PEAK - env_step(read_num(s.pos))
                    elif c == 's': v.sustain   = read_num(s.pos) * ENV_PEAK / 64
                    elif c == 'W': v.pw        = read_num(s.pos) * 4
                    elif c == 'w': v.pw_rate   = read_num(s.pos)
                    elif c == 'Y': v.vib_depth = read_num(s.pos)
                    elif c == 'y': v.vib_rate  = read_num(s.pos)
                    elif c == 'T': v.wave      = WAVE_TRI
                    elif c == 'S': v.wave      = WAVE_SAW
                    elif c == 'P': v.wave      = WAVE_PULSE
                    elif c == 'N': v.wave      = WAVE_NOISE
                    elif c == '=' or c == '~':
                        v.pitch_offset = read_num(s.pos) * 64
                        v.abs_pitch    = c == '='
                    elif c == '|': s.loop = s.pos
                    elif c == ',':
                        s.wait = read_num(s.pos) ?: 1
                        break
                    else:
                        s.pos = s.loop
                        if not s.pos:
                            break
            s.wait -= 1

        # adsr
        if v.env == ENV_ATTACK:
            v.level = min(v.level + v.attack, ENV_PEAK)
            if v.level == ENV_PEAK: v.env = ENV_DECAY
        if v.env == ENV_DECAY: v.level = v.sustain + (v.level - v.sustain) * v.decay / ENV_PEAK
        if v.env == ENV_RELEASE: v.level = v.level * v.release / ENV_PEAK

        # pitch
        if v.pitch != v.pitch_target:
            v.pitch = clamp(v.pitch_target, v.pitch - v.porta_speed, v.pitch + v.porta_speed)
        var pitch = v.pitch_offset
        if not v.abs_pitch: pitch += v.pitch
        pitch /= 8
        if v.vib_depth:
            var x = abs(((v.vib_pos + 64) & 255) - 128)
            pitch += (x * v.vib_depth + 32) / 64 - v.vib_depth

        # set APU registers
        var vol = v.volume * v.instr_vol * v.level / (ENV_PEAK * 64)
        sound(v.index + 4, pitch, v.pw, vol * music.volume / 64, v.wave)

        v.pw += v.pw_rate
        v.pw %= 1024
        v.vib_pos += v.vib_rate
        v.vib_pos %= 256
