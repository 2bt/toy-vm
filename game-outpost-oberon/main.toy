include "api.toy"
include "util.toy"
include "sound.toy"
include "music.toy"
include "game.toy"


var is_initialized

func tick():
    if not is_initialized:
        is_initialized = true
        game_init()

    game_update()
    game_draw()
    sound_update()
    music_update()

    not_prev_input = -1-input
