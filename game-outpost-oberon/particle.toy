const PARTICLE_FLASH = 1

struct Particle:
    ttl
    x
    y
    type

var particles: Particle[32]

func particle_spawn(type, x, y):
    for p in particles:
        if p.ttl == 0:
            p.type = type
            p.x    = x
            p.y    = y
            if type == PARTICLE_FLASH:
                p.ttl = 3
            return

func particle_update_all():
    for p in particles:
        if p.ttl == 0: continue
        p.ttl -= 1

func particle_draw_all():
    for p in particles:
        if p.ttl == 0: continue
        if p.type == PARTICLE_FLASH:
            camera_sprite(p.x - 2, p.y - 2, 5, 5, 16, 96, 0)


