var SFX_SPAWN = "
@3 d8 T=53,,=60|,~7,,~7,,~8,,~-21,
@2 v50 l15a9r9 N=30|f22,
"
var SFX_EXIT = "
@3 d8 T=82,~-8,,,~-8,,,~-6,,,|~22,,~-8,,~-8,,~-6,,
@2 v50 l15a9r9 N=90|f-14,
"
var SFX_LAND         = "@1 v45 d1 N=38,=33,9"
var SFX_HERO_JUMP    = "@1 v50 l3 s64r2 S=45,|f6,"
var SFX_HERO_SHOOT   = "@0 d5 W128w4 P=76,=70,|f-18,,f16,"
var SFX_BULLET_WALL  = "@2 v32d1 N=100,=70,10"
var SFX_CHARGE       = "@3 l10a10 N=40|,~4"
var SFX_PATROL_SHOOT = "@0 d5 W20w2 P=80|,~3,~3,~-3,~-3,"
var SFX_BUGGER_JUMP  = "@3 d3 W32 P=44,~4,~4|f4,"
var SFX_ENEMY_HIT    = "@2 d3 N=66,T=60,=54,=50,"
var SFX_EXPLOSION    = "@3 d8 N|=60,~-10,~-10,~-8,,"
var SFX_CHECKPOINT   = "@3 l99 a5d10 T=44|,,~7,,~8,,~-14"


struct SfxStream:
    index
    pos: int*
    loop: int*
    wait
    env
    level
    length
    attack
    decay
    sustain
    release
    wave
    volume
    pitch
    pw
    pw_rate
    vib_pos
    vib_rate
    vib_depth


var sfx_streams: SfxStream[4]

func sfx_play(p: int*):
    var c
    var i
    while p.*:
        c = p.*
        p += 1
        if c == '#': skip_line(p)
        elif c == '@':
            i = read_num(p)
            if i < sfx_streams.len:
                var s = &sfx_streams[i]
                if not s.pos:
                s.* = {}
                s.env     = ENV_ATTACK
                s.attack  = ENV_PEAK
                s.index   = i
                s.pos     = p
                s.volume  = 64
                s.length  = 999

func sfx_update():
    for s in sfx_streams:
        if not s.pos: continue

        if s.wait <= 0:
            while true:
                var c = s.pos.*
                s.pos += 1
                if   c == ' ':
                elif c == 'v': s.volume    = read_num(s.pos)
                elif c == 'l': s.length    = read_num(s.pos)
                elif c == 'a': s.attack    = env_step(read_num(s.pos))
                elif c == 'd': s.decay     = ENV_PEAK - env_step(read_num(s.pos))
                elif c == 'r': s.release   = ENV_PEAK - env_step(read_num(s.pos))
                elif c == 's': s.sustain   = read_num(s.pos) * ENV_PEAK / 64
                elif c == 'W': s.pw        = read_num(s.pos)
                elif c == 'w': s.pw_rate   = read_num(s.pos)
                elif c == 'Y': s.vib_depth = read_num(s.pos)
                elif c == 'y': s.vib_rate  = read_num(s.pos)
                elif c == 'T': s.wave      = WAVE_TRI
                elif c == 'S': s.wave      = WAVE_SAW
                elif c == 'P': s.wave      = WAVE_PULSE
                elif c == 'N': s.wave      = WAVE_NOISE
                elif c == '=': s.pitch     = read_num(s.pos) * 8
                elif c == '~': s.pitch     += read_num(s.pos) * 8
                elif c == 'f': s.pitch     += read_num(s.pos)
                elif c == '|': s.loop      = s.pos
                elif c == ',':
                    s.wait = read_num(s.pos) ?: 1
                    break
                else:
                    s.pos = s.loop
                    if not s.pos:
                        break
        s.wait -= 1

        # adsr
        if s.env == ENV_ATTACK:
            s.level = min(s.level + s.attack, ENV_PEAK)
            if s.level == ENV_PEAK: s.env = ENV_DECAY
        if s.env == ENV_DECAY: s.level = s.sustain + (s.level - s.sustain) * s.decay / ENV_PEAK
        if s.env == ENV_RELEASE: s.level = s.level * s.release / ENV_PEAK

        var pitch = s.pitch
        if s.vib_depth:
            # return 64 - abs(((x + 64) & 255) - 128);
            var x = s.vib_pos % 128
            if x > 64: x = 128 - x
            if s.vib_pos >= 128: x = -x
            pitch += x * s.vib_depth / 64

        # set APU registers
        sound(s.index, pitch, s.pw, s.volume * s.level / ENV_PEAK, s.wave)

        s.pw += s.pw_rate
        s.pw %= 256
        s.vib_pos += s.vib_rate
        s.vib_pos %= 256
        s.length -= 1
        if s.length <= 0: s.env = ENV_RELEASE
