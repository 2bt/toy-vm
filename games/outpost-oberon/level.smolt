# moving platform: a row of 'V' tiles in the level data; moves up and down
# through free tiles and turns around at a solid tile or on the row of a '.'
struct Platform:
    x       # pixels
    w
    y       # top surface, pixels
    sy      # top surface, subpixels
    vy
    top     # sy range
    bottom
    wait    # frames to pause before moving on

const PLATFORM_SPEED = 8   # subpixels per frame: half a pixel
const PLATFORM_WAIT  = 60  # pause at each end, in frames

struct Level:
    data: int*
    w
    h
    spawn_x
    spawn_y
    tick
    checkpoints: Vec[8]
    checkpoint_count
    active_checkpoint: Vec*
    checkpoint_tick
    platforms: Platform[8]
    platform_count

var level: Level


func level_init(data: int*):
    level.data = data
    level.w    = stridx(data, 'X') + 1
    level.h    = strlen(data) / level.w
    level.tick = 0

    # spawn pos
    var i = stridx(level.data, 'h')
    if i >= 0:
        level.spawn_x = i % level.w * TS + 8
        level.spawn_y = i / level.w * TS + 16
    else:
        i = stridx(level.data, 'S')
        var l = 1
        while level.data[i] == 'S':
            i += 1
            l += 1
        level.spawn_x = i % level.w * TS - l  * TS / 2 + 8
        level.spawn_y = i / level.w * TS + 20

    # set up checkpoints
    level.active_checkpoint = null
    level.checkpoint_count = 0
    for r = 0, level.h:
        for c = 0, level.w:
            var t = level_get_tile_at_cr(c, r)
            if t == 'C':
                if level.checkpoint_count >= level.checkpoints.len: print("error: not enough checkpoints")
                level.checkpoints[level.checkpoint_count] = { c * TS, r * TS }
                level.checkpoint_count += 1

    # set up platforms
    level.platform_count = 0
    for r = 0, level.h:
        for c = 0, level.w:
            if level_get_tile_at_cr(c, r) != 'V' or level_get_tile_at_cr(c - 1, r) == 'V': continue
            if level.platform_count >= level.platforms.len:
                print("error: not enough platforms")
                continue
            var n = 1
            while level_get_tile_at_cr(c + n, r) == 'V': n += 1
            var p = &level.platforms[level.platform_count]
            level.platform_count += 1
            p.*  = {}
            p.x  = c * TS
            p.w  = n * TS
            p.y  = r * TS
            p.sy = p.y * SP
            p.vy = -PLATFORM_SPEED
            p.top    = level_platform_end(c, n, r, -1) * TS * SP
            p.bottom = level_platform_end(c, n, r, 1) * TS * SP


# last row a platform at row r, columns c to c + n - 1, can reach going in direction dr
func level_platform_end(c, n, r, dr) int:
    while true:
        var stop = false
        for i = c, c + n:
            var t = level_get_tile_at_cr(i, r + dr)
            if level_is_solid(t): return r
            if t == '.': stop = true
        r += dr
        if stop: return r


func level_platform_supports(p: Platform*, b: Box*) int:
    return b.y + b.h == p.y and b.x < p.x + p.w and b.x + b.w > p.x


func level_get_tile_at_cr(c, r):
    if c < 0 or c >= level.w: return '0'
    if r < 0 or r >= level.h: return '0'
    c = level.data[c + r * level.w]
    if c == 'X': return '0'
    return c

func level_get_tile(x, y):
    return level_get_tile_at_cr(x / TS, y / TS)

func level_is_solid(t):
    return t == '0' or t == 'X'


func level_has_los(x0, y0, x1, y1):
    var c0 = x0 / TS
    var r0 = y0 / TS
    var c1 = x1 / TS
    var r1 = y1 / TS
    if c0 == c1 and r0 == r1: return true

    var dx = x1 - x0
    var dy = y1 - y0
    var steps = abs(dx)
    if abs(dy) > steps: steps = abs(dy)

    var i = 1
    while i <= steps:
        var x = x0 + dx * i / steps
        var y = y0 + dy * i / steps
        var tc = x / TS
        var tr = y / TS
        if (tc != c0 or tr != r0) and (tc != c1 or tr != r1):
            if level_is_solid(level_get_tile_at_cr(tc, tr)): return false
        i += 1
    return true


# debug collision probes (flushed each frame via level_draw_dots)
struct LevelDot:
    x
    y
var level_dots: LevelDot[256]
var level_dot_count

func level_dot(x, y):
    return # XXX
    level_dots[level_dot_count] = {x, y}
    level_dot_count += 1

func level_draw_dots():
    for i = 0, level_dot_count:
        var d = level_dots[i]
        camera_sprite(d.x, d.y, 1, 1, 13, 24, 0)
    level_dot_count = 0


# collision
const DIR_LEFT  = 1
const DIR_RIGHT = 2
const DIR_UP    = 3
const DIR_DOWN  = 4

func level_test(x, y, dir) int:
    level_dot(x, y)
    if level_get_tile(x, y) != '0': return 0
    if dir == DIR_LEFT:  return TS - (x % TS)
    if dir == DIR_RIGHT: return -1 - (x % TS)
    if dir == DIR_UP:    return TS - (y % TS)
    if dir == DIR_DOWN:  return -1 - (y % TS)

func level_test_down(x, y, py) int:
    level_dot(x, y)
    var o = 0
    var t = level_get_tile(x, y)
    if (t == '0' or
        t == '^' and (y / TS) > (py / TS)):
        o = -1 - (y % TS)
    # platforms are jump-through: only land when moving down from above.
    # py <= p.y, not <: a rising platform (1 px per frame at most) may have just moved into py
    for i = 0, level.platform_count:
        var p = &level.platforms[i]
        # no min() here: callers use min(level_test_down(…), level_test_down(…))
        if x >= p.x and x < p.x + p.w and py < y and py <= p.y and y >= p.y and p.y - 1 - y < o:
            o = p.y - 1 - y
    return o

# Resolve axis motion for enemy boxes. Mutates sx/sy and box.x/box.y.
# Probes: two points on the leading face (simple; not hero-grade).
func level_move_box_x(sx: int*, box: Box*, dx) int:
    sx.* = sx.* + dx
    var x = sx.* / SP
    if x == box.x: return 0

    var y1 = box.y + box.h - 1
    var o
    if dx < 0:
        o = max(level_test(x, box.y, DIR_LEFT), level_test(x, y1, DIR_LEFT))
        if o:
            x += o
            sx.* = x * SP
            box.x = x
            return DIR_LEFT
    else:
        o = min(level_test(x + box.w - 1, box.y, DIR_RIGHT),
                level_test(x + box.w - 1, y1, DIR_RIGHT))
        if o:
            x += o
            sx.* = x * SP + SP - 1
            box.x = sx.* / SP
            return DIR_RIGHT
    box.x = x
    return 0


func level_move_box_y(sy: int*, box: Box*, dy, pass_platforms) int:
    sy.* = sy.* + dy
    var y = sy.* / SP
    if y == box.y: return 0

    var x1 = box.x + box.w - 1
    var o
    if dy > 0:
        var foot = y + box.h - 1
        var py = pass_platforms ? foot : box.y + box.h - 1
        o = min(level_test_down(box.x, foot, py), level_test_down(x1, foot, py))
        if o:
            y += o
            sy.* = y * SP + SP - 1
            box.y = sy.* / SP
            return DIR_DOWN
    else:
        o = max(level_test(box.x, y, DIR_UP), level_test(x1, y, DIR_UP))
        if o:
            y += o
            sy.* = y * SP
            box.y = y
            return DIR_UP
    box.y = y
    return 0



func level_update():
    # moving platforms
    for i = 0, level.platform_count:
        var p = &level.platforms[i]
        if p.wait > 0:
            p.wait -= 1
            continue
        p.sy += p.vy
        if p.sy <= p.top:
            p.sy = p.top
            p.vy = PLATFORM_SPEED
            p.wait = PLATFORM_WAIT
        elif p.sy >= p.bottom:
            p.sy = p.bottom
            p.vy = -PLATFORM_SPEED
            p.wait = PLATFORM_WAIT
        var dy = p.sy / SP - p.y
        if not dy: continue

        # carry whatever stands on it
        if hero.state == HERO_STATE_NORMAL and hero.on_ground and level_platform_supports(p, hero.box):
            hero.sy += dy * SP
            hero.box.y += dy
        for e in enemies:
            if e.state == ENEMY_STATE_NORMAL and e.on_ground and level_platform_supports(p, e.box):
                e.sy += dy * SP
                e.box.y += dy
        p.y += dy

    if hero.state == HERO_STATE_NORMAL:
        for i = 0, level.checkpoint_count:
            var cp = &level.checkpoints[i]
            if cp == level.active_checkpoint: continue
            var box: Box = { cp.x + 8, cp.y - TS, 1, TS * 3 }
            if box_intersects(box, hero.box):
                level.active_checkpoint = cp
                level.checkpoint_tick = 0
                level.spawn_x = cp.x + 8
                level.spawn_y = cp.y + 16
                audio_play_sfx(SFX_CHECKPOINT)

    level.tick += 1
    level.checkpoint_tick += 1



const STAR_N   = 800
const PERIOD_W = 1000
const PERIOD_H = 1000

func level_draw_background():
    # hashed starfield (deterministic; period 1000×1000)
    # var ox = camera.box.x * 4 / 7
    # var oy = camera.box.y * 4 / 7
    var ox = camera.box.x /3
    var oy = camera.box.y /3
    for i = 0, STAR_N:
        # quadratic mixes — linear LCG makes a visible lattice mod PERIOD
        var px = (i * (i * 7919 + 104729) + 12345) % PERIOD_W
        var py = (i * (i * 6971 + 224737) + 67890) % PERIOD_H
        var sx = (px - ox) % PERIOD_W
        var sy = (py - oy) % PERIOD_H
        if sx < SCREEN_W and sy < SCREEN_H:
            var g = (i * (i + 19)) % 3
            var grey = g == 0 ? 43 : g == 1 ? 44 : 47
            sprite(sx, sy, 1, 1, 0, grey, 0)

    var c0 = camera.box.x / TS
    var r0 = camera.box.y / TS
    for r = r0, r0 + SCREEN_H / TS + 2:
        for c = c0, c0 + SCREEN_W / TS + 1:
            var t = level_get_tile_at_cr(c, r)
            var x = c * TS - camera.box.x
            var y = r * TS - camera.box.y

            if t == '^':  # jump through platform
                sprite(x, y, TS, TS, 4 * TS, 48, 0)

            elif t == 'E':
                var q = level.tick * 2 % 32
                for i = 0, 32:
                    q = (q + 5) % 31
                    var color = q >= i ? 0 : q > 10 ? 3 : 6
                    if color: sprite(x, y + i - 16, TS, 1, 0, 32 + color, 0)

            elif t == 'S':
                var q = level.tick * 2 % 32
                for i = 0, 32:
                    q = (q + 5) % 31
                    var color = q >= i ? 0 : q > 10 ? 3 : 6
                    if color: sprite(x, y + 31 - i, TS, 1, 0, 32 + color, 0)

    for i = 0, level.platform_count:
        var p = &level.platforms[i]
        for x = 0, p.w / TS:
            camera_sprite(p.x + x * TS, p.y, TS, TS, 4 * TS, 48, 0)

    if level.active_checkpoint:
        var x = level.active_checkpoint.x
        var y = level.active_checkpoint.y
        var q = level.checkpoint_tick * 2 % 32
        for i = 0, 32:
            q = (q + 5) % 31
            var color = q >= min(i, level.checkpoint_tick / 4) or q > 10 ? 0 : 3
            if color: camera_sprite(x, y + i - 16, TS, 1, 0, 32 + color, 0)


func level_draw_walls():
    var c0 = camera.box.x / TS
    var r0 = camera.box.y / TS
    for r = r0, r0 + SCREEN_H / TS + 2:
        for c = c0, c0 + SCREEN_W / TS + 1:
            var t = level_get_tile_at_cr(c, r)
            var x = c * TS - camera.box.x
            var y = r * TS - camera.box.y

            if t == '0':
                # edge
                sprite(x, y, TS, TS, 16, 32, 0)
                if level_get_tile_at_cr(c - 1, r) != '0': sprite(x, y, TS, TS, 0 * TS, 48, 0)
                if level_get_tile_at_cr(c + 1, r) != '0': sprite(x, y, TS, TS, 1 * TS, 48, 0)
                if level_get_tile_at_cr(c, r - 1) != '0': sprite(x, y, TS, TS, 2 * TS, 48, 0)
                if level_get_tile_at_cr(c, r + 1) != '0': sprite(x, y, TS, TS, 3 * TS, 48, 0)

            elif t == 'L':  # lava
                sprite(x, y, TS, TS, 5 * TS, 48, 0)
            elif t == 'l':  # lava surface
                var f = (level.tick + c * 25) / 6 % 7
                sprite(x, y, TS, TS, (6 + f) * TS, 48, 0)
