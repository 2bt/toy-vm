const ENEMY_TYPE_PATROL = 1
const ENEMY_TYPE_SPIDER = 2

const SPIDER_MODE_SLEEP  = 0
const SPIDER_MODE_FOLLOW = 1
const SPIDER_MODE_WALK   = 2

const SPIDER_SPEED           = 14
const SPIDER_WALK_SPEED      = 7
const SPIDER_ACCEL           = 1
const SPIDER_LOC_LOST_FRAMES = 180

const ENEMY_STATE_DEAD   = 0
const ENEMY_STATE_NORMAL = 1
const ENEMY_STATE_DYING  = 2

const ENEMY_BULLET_TYPE_BASIC = 1


struct EnemyBullet:
    alive
    type
    x
    y
    vx
    vy

var enemy_bullets: EnemyBullet[16]

func enemy_bullet_spawn(type, x, y) EnemyBullet*:
    for b in enemy_bullets:
        if b.alive: continue
        b.* = {}
        b.alive = true
        b.type = type
        b.x = x
        b.y = y
        return b
    return null


func enemy_bullet_update_all():
    var view = camera.box
    box_grow(view, 8)

    for b in enemy_bullets:
        if not b.alive: continue

        if b.type == ENEMY_BULLET_TYPE_BASIC:
            b.x += b.vx
            b.y += b.vy

            if not box_has_point(view, b.x, b.y):
                b.alive = 0
                continue

            var dir = b.vx > 0 ? DIR_RIGHT : DIR_LEFT
            var o = check_collision(b.x, b.y, dir)
            if o:
                b.alive = false
                particle_spawn(PARTICLE_TYPE_FLASH, b.x + o, b.y)
                play_sound(SOUND_BULLET_WALL)
                continue

            if hero.state == HERO_STATE_NORMAL:
                if box_has_point(hero.box, b.x, b.y):
                    b.alive = false
                    hero_set_state(HERO_STATE_DYING)
                    continue

func enemy_bullet_draw_all():
    for b in enemy_bullets:
        if not b.alive: continue
        if b.type == ENEMY_BULLET_TYPE_BASIC:
            camera_sprite(b.x - (b.vx > 0 ? 5 : 0), b.y, 6, 1,
                          0, 32 + 1, 0)


struct Enemy:
    state
    active
    box: Box
    type
    sx
    sy
    hp

    facing_left
    frame
    hit_countdown

    # movement (spider; patrol leaves unused)
    mode
    vx
    vy
    on_ground
    no_turn_countdown

    # patrol / spider timers (spider: wait = sleep / turn / land pause;
    # pace = loc-lost / stroll)
    run_tick
    wait_countdown
    wait_turn
    pace_countdown
    shoot_countdown
    burst_left
    aim_countdown



var enemies: Enemy[64]


func enemy_spawn(type, x, y):
    for e in enemies:
        if e.state: continue
        e.* = {}
        e.state = ENEMY_STATE_NORMAL
        e.type  = type

        if type == ENEMY_TYPE_PATROL:
            e.box.w           = 8
            e.box.h           = 17
            e.hp              = 2
            e.pace_countdown  = rand(30, 80)

        elif type == ENEMY_TYPE_SPIDER:
            e.box.w = 12
            e.box.h = 11
            e.hp    = 1
            e.on_ground = true
            e.mode = SPIDER_MODE_SLEEP

        e.sx = (x + 8 - e.box.w / 2) * SP
        e.sy = (y + 16 - e.box.h) * SP
        e.box.x = e.sx / SP
        e.box.y = e.sy / SP
        return

    print("enemy spawn error")


func enemy_init_all():
    for e in enemies: e.* = {}
    for r = 0, level.h:
        for c = 0, level.w:
            var x = c * TS
            var y = r * TS
            var t = level_get_tile_at_cr(c, r)
            if t == 'p': enemy_spawn(ENEMY_TYPE_PATROL, x, y)
            elif t == 's': enemy_spawn(ENEMY_TYPE_SPIDER, x, y)


func enemy_kill(e: Enemy*):
    e.state = ENEMY_STATE_DYING
    e.hit_countdown = 20
    e.vx = 0
    e.vy = 0
    play_sound(SOUND_ENEMY_DIE)


func enemy_hit(e: Enemy*):
    if e.state != ENEMY_STATE_NORMAL: return
    e.hp -= 1
    e.hit_countdown = 3

    if e.type == ENEMY_TYPE_PATROL and e.aim_countdown == 0:
        e.shoot_countdown /= 2
        if e.facing_left != (box_center_x(e.box) > box_center_x(hero.box)):
            e.wait_countdown = min(10, e.shoot_countdown)
            e.wait_turn      = true

    if e.hp <= 0: enemy_kill(e)
    else: play_sound(SOUND_ENEMY_HIT)


func enemy_update_patrol(e: Enemy*):
    if e.aim_countdown > 0:
        e.frame = 0
    elif e.wait_countdown > 0:
        e.wait_countdown -= 1
        if e.wait_countdown == 0:
            if e.wait_turn: e.facing_left = not e.facing_left
            e.pace_countdown = rand(30, 180)
        e.frame = 0
    else:

        # walk
        var dx = e.facing_left ? -6 : 6
        var hit = level_move_box_x(e.sx, e.box, dx)

        var face_x = e.facing_left ? e.box.x : e.box.x + e.box.w - 1
        var foot_y = e.box.y + e.box.h
        var turn = -1
        if hit or not check_collision_down(face_x, foot_y, foot_y - 1):
            turn = 1
        else:
            e.run_tick += 1
            e.frame = 1 + e.run_tick / 4 % 4
            e.pace_countdown -= 1
            if e.pace_countdown == 0: turn = rand(0, 4) == 0
        if turn >= 0:
            e.wait_countdown = rand(50, 90)
            e.wait_turn = turn > 0
            e.frame = 0

    e.box.x = e.sx / SP
    e.box.y = e.sy / SP


    var muzzle_x = e.facing_left ? e.box.x - 2 : e.box.x + e.box.w + 1
    var muzzle_y = e.box.y + 7
    if e.aim_countdown > 0:
        e.aim_countdown -= 1
        if e.aim_countdown == 19:
            play_sound(SOUND_CHARGE)
            particle_spawn(PARTICLE_TYPE_CHARGE, muzzle_x, muzzle_y)
        if e.aim_countdown == 5:
            var b = enemy_bullet_spawn(ENEMY_BULLET_TYPE_BASIC, muzzle_x, muzzle_y)
            if b:
                b.vx = e.facing_left ? -2 : 2
                play_sound(SOUND_PATROL_SHOOT)

        if e.aim_countdown == 0:
            e.burst_left -= 1
            if e.burst_left > 0: e.aim_countdown = 30
            else:
                e.shoot_countdown = rand(60, 200)
                e.burst_left = rand(1, 2)

    elif e.shoot_countdown > 0:
        e.shoot_countdown -= 1

    elif e.active and hero.state == HERO_STATE_NORMAL:
        var ex = box_center_x(e.box)
        var ey = box_center_y(e.box)
        var hx = box_center_x(hero.box)
        var hy = box_center_y(hero.box)

        if (e.facing_left == (hx < ex)
        and abs(hy - ey) <= 70
        and box_encloses(camera.box, e.box)
        and (level_has_los(ex, ey, hx, hy) or level_has_los(ex, ey, hx, ey))):
            e.aim_countdown = 20
        else:
            e.shoot_countdown = rand(30, 150)
            e.burst_left = rand(1, 2)




func spider_has_loc(e: Enemy*) int:
    if not box_encloses(camera.box, e.box): return 0
    var ex = box_center_x(e.box)
    var ey = box_center_y(e.box)
    var hx = box_center_x(hero.box)
    var hy = box_center_y(hero.box)
    return level_has_los(ex, ey, hx, hy)

func enemy_update_spider(e: Enemy*):
    if not e.active: return

    var hx = box_center_x(hero.box)
    var hy = box_center_y(hero.box)

    var ex = box_center_x(e.box)
    var ey = box_center_y(e.box)
    var loc = spider_has_loc(e)

    if e.mode == SPIDER_MODE_SLEEP:
        if loc:
            e.mode = SPIDER_MODE_FOLLOW
            e.pace_countdown = 0
            e.wait_countdown = 0
    elif e.mode == SPIDER_MODE_FOLLOW:
        if loc:
            e.pace_countdown = 0
        else:
            e.pace_countdown += 1
            if e.pace_countdown >= SPIDER_LOC_LOST_FRAMES:
                e.mode = SPIDER_MODE_WALK
                e.pace_countdown = rand(120, 360)
                e.wait_countdown = 0
    elif e.mode == SPIDER_MODE_WALK:
        if loc:
            e.mode = SPIDER_MODE_FOLLOW
            e.pace_countdown = 0
            e.wait_countdown = 0
        else:
            if e.pace_countdown > 0: e.pace_countdown -= 1
            else:
                e.mode = SPIDER_MODE_SLEEP
                e.vx = 0
                e.wait_countdown = 0

    var dx   = 0
    var jump = 0

    if e.no_turn_countdown > 0: e.no_turn_countdown -= 1

    if e.mode == SPIDER_MODE_SLEEP:
        if e.on_ground:
            e.vx = clamp(0, e.vx - SPIDER_ACCEL, e.vx + SPIDER_ACCEL)
            e.frame = 0

    elif e.mode == SPIDER_MODE_FOLLOW:
        var want_left = hx < ex
        if e.on_ground:
            if e.wait_countdown > 0:
                e.wait_countdown -= 1
                e.vx = clamp(0, e.vx - SPIDER_ACCEL, e.vx + SPIDER_ACCEL)
                e.frame = 0
            elif e.no_turn_countdown <= 0 and want_left != e.facing_left:
                e.facing_left = want_left
                e.wait_countdown = rand(10, 20)
            else:
                var wall_x  = e.facing_left ? e.box.x - 10 : e.box.x + e.box.w - 1 + 10
                var ledge_x = e.facing_left ? e.box.x      : e.box.x + e.box.w - 1

                if abs(e.vx) == SPIDER_SPEED:
                    if check_collision(wall_x, e.box.y, e.facing_left ? DIR_LEFT : DIR_RIGHT):
                        jump = 44
                    elif not check_collision_down(ledge_x, e.box.y + e.box.h, e.box.y + e.box.h - 1):
                        jump = 24
                    else:
                        if (abs(hx - ex) <= 35
                        and abs(hy - ey) <= 20): jump = 44
                    if jump:
                        e.vy = -jump
                        e.on_ground = false

                dx = e.facing_left ? -1 : 1

            e.vx = clamp(dx * SPIDER_SPEED, e.vx - SPIDER_ACCEL, e.vx + SPIDER_ACCEL)

    elif e.mode == SPIDER_MODE_WALK:
        if e.on_ground:
            var walk_wall_x  = e.facing_left ? e.box.x - 10 : e.box.x + e.box.w - 1 + 10
            var walk_ledge_x = e.facing_left ? e.box.x      : e.box.x + e.box.w - 1
            var walk_wall_dir = e.facing_left ? DIR_LEFT : DIR_RIGHT
            if e.no_turn_countdown <= 0:
                if (check_collision(walk_wall_x, e.box.y, walk_wall_dir)
                or not check_collision_down(walk_ledge_x, e.box.y + e.box.h, e.box.y + e.box.h - 1)):
                    e.facing_left = not e.facing_left
                    e.no_turn_countdown = 10
            dx = e.facing_left ? -1 : 1
            e.vx = clamp(dx * SPIDER_WALK_SPEED, e.vx - SPIDER_ACCEL, e.vx + SPIDER_ACCEL)


    if level_move_box_x(e.sx, e.box, e.vx):
        if e.on_ground:
            if e.mode == SPIDER_MODE_WALK:
                e.facing_left = not e.facing_left
                e.vx = 0
                e.no_turn_countdown = 10
            else:
                e.facing_left = e.vx > 0
                e.vx = 0
                e.no_turn_countdown = rand(30, 50)
        else:
            e.vx = -e.vx
            e.wait_turn = true

    e.vy += GRAVITY
    e.vy = min(e.vy, SP * 4)
    var was_air = not e.on_ground
    var d = level_move_box_y(e.sy, e.box, e.vy)
    if d == DIR_DOWN:
        e.on_ground = true
        e.vy = 0
        if was_air and e.wait_turn and e.mode == SPIDER_MODE_FOLLOW:
            e.wait_countdown = rand(10, 40)
            e.wait_turn = false
    elif d == DIR_UP:
        e.vy = 8
        e.on_ground = false
    else:
        e.on_ground = false

    if e.mode == SPIDER_MODE_SLEEP:
        e.frame = 0
    elif e.wait_countdown == 0:
        e.run_tick += 1
        e.frame = 1 + e.run_tick / 4 % 4

    var t = level_get_tile(e.box.x, e.box.y)
    if t == 'l':
        enemy_kill(e)
        e.vy = 4



func enemy_update_all():
    var view = camera.box
    box_grow(view, 32)

    for e in enemies:
        if e.state == ENEMY_STATE_DEAD: continue

        if e.state == ENEMY_STATE_DYING:
            e.sx += e.vx
            e.sy += e.vy
            e.box.x = e.sx / SP
            e.box.y = e.sy / SP

            if e.hit_countdown > 5:
                particle_spawn(PARTICLE_TYPE_DEBRIS,
                               rand(e.box.x, e.box.x + e.box.w - 1),
                               rand(e.box.y, e.box.y + e.box.h - 1))

            if e.hit_countdown > 0: e.hit_countdown -= 1
            else:
                e.state  = ENEMY_STATE_DEAD
                e.active = false

                # scoring
                hero.score += (
                    e.type == ENEMY_TYPE_PATROL ? 100 :
                    e.type == ENEMY_TYPE_SPIDER ? 150 :
                    0)

            continue

        if e.state != ENEMY_STATE_NORMAL: continue


        var prev_active = e.active
        e.active = box_intersects(view, e.box)
        if e.active and not prev_active:
            e.facing_left = e.sx > hero.sx

        if e.hit_countdown > 0: e.hit_countdown -= 1

        if e.type == ENEMY_TYPE_PATROL: enemy_update_patrol(e)
        elif e.type == ENEMY_TYPE_SPIDER: enemy_update_spider(e)


func enemy_draw_all():
    for e in enemies:
        if not e.active: continue


        if e.state == ENEMY_STATE_DYING and e.hit_countdown & 2: continue

        if e.type == ENEMY_TYPE_PATROL:
            camera_sprite(e.box.x - 4, e.box.y - 15, 16, 32,
                          256 + e.frame * 16,
                          0 + (e.hit_countdown > 0) * 32,
                          e.facing_left)
        elif e.type == ENEMY_TYPE_SPIDER:
            camera_sprite(e.box.x - 2, e.box.y - 5, 16, 16,
                          256 + e.frame * 16,
                          80 + (e.hit_countdown > 0) * 16,
                          e.facing_left)


        # box
        # camera_sprite(e.box.x, e.box.y, e.box.w, e.box.h, 0, 480, 0)
