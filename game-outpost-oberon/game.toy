include "level.toy"


# collision debugging
struct Dot:
    x
    y
var dots: Dot[99]
var dot_count
func dot(x, y):
    dots[dot_count] = {x, y}
    dot_count += 1
func draw_dots():
    for i = 0, dot_count:
        var d = dots[i]
        camera_sprite(d.x, d.y, 1, 1, 1, 24, 0)


# collision
const DIR_LEFT  = 0
const DIR_RIGHT = 1
const DIR_UP    = 2
const DIR_DOWN  = 3

func check_collision(x, y, dir) -> int:
    dot(x, y)
    if level_get_tile(x, y) != '0': return 0
    if dir == DIR_LEFT:  return TS - (x % TS)
    if dir == DIR_RIGHT: return -1 - (x % TS)
    if dir == DIR_UP:    return TS - (y % TS)
    if dir == DIR_DOWN:  return -1 - (y % TS)

func check_collision_down(x, y, py) -> int:
    dot(x, y)
    var t = level_get_tile(x, y)
    if (t == '0' or
        t == '^' and (y / TS) > (py / TS)):
        return -1 - (y % TS)
    return 0


include "particle.toy"
include "enemy.toy"


# bullet

struct Bullet:
    alive
    x
    y
    dx

var bullets: Bullet[8]

func bullet_new(x, y, dx):
    for b in bullets:
        if b.alive: continue
        b.alive = true
        b.x = x
        b.y = y
        b.dx = dx
        return

func bullet_update_all():

    var view = camera
    box_grow(view, 8)

    for b in bullets:
        if not b.alive: continue
        b.x += b.dx * 5 # speed

        if not box_has_point(view, b.x, b.y):
            b.alive = 0

        var dir = b.dx > 0 ? DIR_RIGHT : DIR_LEFT
        var o = check_collision(b.x, b.y, dir)
        if o:
            b.alive = false
            particle_spawn(PARTICLE_FLASH, b.x + o, b.y)
            continue

        for e in enemies:
            if not e.alive: continue
            if box_has_point(e.box, b.x, b.y):
                b.alive = false
                particle_spawn(PARTICLE_FLASH, b.x, b.y)
                enemy_hit(e)
                continue



func bullet_draw_all():
    for b in bullets:
        if not b.alive: continue
        camera_sprite(b.x - (b.dx > 0 ? 5 : 0), b.y, 6, 1, 0, 96, 0)



# hero

struct Hero:
    x
    y
    vx
    vy
    facing_left
    on_ground

    frame
    run_tick
    shoot_tick

var hero: Hero

func hero_init():
    hero = {}
    var i = stridx(level.data, 'h')
    hero.x = i % level.w * TS
    hero.y = i / level.w * TS
    hero.x *= SPX
    hero.y *= SPX



const RUN_MAX      = 20
const ACCEL_GROUND = 5
const ACCEL_AIR    = 2
const JUMP_FORCE   = 48


func hero_update():
    dot_count = 0

    # horizontal movement
    var dx = btn(BTN_RIGHT) - btn(BTN_LEFT)
    if dx: hero.facing_left = dx < 0
    var accel = hero.on_ground ? ACCEL_GROUND : ACCEL_AIR
    hero.vx = clamp(RUN_MAX * dx, hero.vx - accel, hero.vx + accel)
    hero.x += hero.vx

    var x = hero.x / SPX
    var y = hero.y / SPX

    # horizontal collision
    var o
    o = max(check_collision(x + 6, y +  7, DIR_LEFT),
            check_collision(x + 4, y + 13, DIR_LEFT))
    if o:
        x += o
        hero.x = x * SPX
        hero.vx = 0
    o = min(check_collision(x + 9, y +  7, DIR_RIGHT),
            check_collision(x + 11, y + 13, DIR_RIGHT))
    if o:
        x += o
        hero.x = x * SPX
        if hero.vx > 0: hero.x += SPX - 1
        hero.vx = 0


    # jump
    if hero.on_ground and btnp(BTN_A): hero.vy = -JUMP_FORCE
    elif not btn(BTN_A) and hero.vy < -10: hero.vy = -10

    # gravity
    # hero.vy = (btn(BTN_DOWN) - btn(BTN_UP)) * SPX
    hero.vy += 2
    hero.vy = min(hero.vy, SPX * 4)

    # floor collision
    var py = hero.y / SPX
    hero.y += hero.vy
    y = hero.y / SPX
    o = min(check_collision_down(x +  5, y + 15, py + 15),
            check_collision_down(x + 10, y + 15, py + 15))
    if o:
        hero.on_ground = true
        y += o
        hero.y = y * SPX + SPX - 1
        hero.vy = 0
    else:
        hero.on_ground = false

    # ceiling collision
    o = check_collision(x + 8 - hero.facing_left, y + 5, DIR_UP)
    if o:
        y += o
        hero.y = y * SPX
        hero.vy = 8


    # shoot
    if hero.shoot_tick == 0:
        if btn(BTN_B):
            hero.shoot_tick = 12
            if hero.facing_left:
                bullet_new(x + 4, y + 9, -1)
            else:
                bullet_new(x + 11, y + 9, 1)
    else:
        hero.shoot_tick -= 1


    # animation
    hero.frame = 0
    if not hero.on_ground:
        hero.frame = 4
    elif dx:
        hero.frame = 1 + hero.run_tick / 4 % 4
        hero.run_tick += 1
    else:
        hero.run_tick = 4
        hero.frame = 0


    # update camera
    camera.x = hero.x / SPX - SCREEN_W / 2
    camera.y = hero.y / SPX - SCREEN_H / 2
    camera.x = clamp(camera.x, 0, level.w * TS - SCREEN_W)
    camera.y = clamp(camera.y, 0, level.h * TS - SCREEN_H)



func hero_draw():

    var x = hero.x / SPX
    var y = hero.y / SPX

    var shooting = hero.shoot_tick > 1
    camera_sprite(x, y, 16, 16,
                  hero.frame * 16,
                  64 + shooting * 16,
                  hero.facing_left)


func game_init():
    level_init(LEVEL1_DATA)
    hero_init()
    enemy_init_all()


func game_update():
    level_update()
    hero_update()
    enemy_update_all()
    bullet_update_all()
    particle_update_all()

    # draw_dots()

func game_draw():
    level_draw_background()
    enemy_draw_all()
    hero_draw()
    bullet_draw_all()
    particle_draw_all()
    level_draw_walls()

