# ---------------------------------------------------------------------------
# Runtime: 4 voices × 2 stream slots (slot 1 unused for now)
# ---------------------------------------------------------------------------

struct SoundCommandStream:
    pos: int*
    loop: int*
    wait

struct Voice:
    pitch
    pw
    vol         # 8.8 fixed (>> 8 for APU)
    vol_target  # 8.8 fixed
    vol_rate
    wave
    cmd_streams: SoundCommandStream[2]

var voices: Voice[4]


func play_sound(e: SoundEffect*):
    var v = &voices[e.voice_index]
    v.cmd_streams = {}
    v.cmd_streams[0].pos = e.start0
    v.cmd_streams[1].pos = e.start1


func update_stream(v: Voice*, s: SoundCommandStream*):
    while s.pos:
        if s.wait > 0:
            s.wait -= 1
            return
        var n = s.pos.*
        s.pos += 1
        if n < 100:
            if n == 0:
                s.pos = 0
                return
            s.wait = n
            continue
        if n == SNDCMD_SET_PITCH:
            v.pitch = s.pos.*
            s.pos += 1
        elif n == SNDCMD_INC_PITCH:
            v.pitch += s.pos.*
            s.pos += 1
        elif n == SNDCMD_SET_VOL:
            v.vol = s.pos.* * 256
            v.vol_target = v.vol
            v.vol_rate = 0
            s.pos += 1
        elif n == SNDCMD_SET_VOL_TARGET:
            v.vol_target = s.pos.* * 256
            s.pos += 1
            v.vol_rate = s.pos.*
            s.pos += 1
        elif n == SNDCMD_SET_PW:
            v.pw = s.pos.*
            s.pos += 1
        elif n == SNDCMD_INC_PW:
            v.pw += s.pos.*
            s.pos += 1
        elif n == SNDCMD_SET_WAVE:
            v.wave = s.pos.*
            s.pos += 1
        elif n == SNDCMD_LOOP_START:
            s.loop = s.pos
        elif n == SNDCMD_LOOP_END:
            s.pos = s.loop


func update_vol(v: Voice*):
    if v.vol_rate == 0: return
    if v.vol == v.vol_target: return

    var d = abs(v.vol - v.vol_target)
    var step = d * v.vol_rate / 64
    if step < 1: step = 1

    if v.vol < v.vol_target:
        v.vol = min(v.vol + step, v.vol_target)
    else:
        v.vol = max(v.vol - step, v.vol_target)


func update_sound():
    for i = 0, 4:
        var v = &voices[i]
        update_vol(v)
        for s in v.cmd_streams:
            if s.pos: update_stream(v, s)
        sound(i, v.pitch, v.pw, v.vol / 256, v.wave)
