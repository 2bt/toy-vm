const WAVE_TRI   = 1
const WAVE_SAW   = 2
const WAVE_PULSE = 3
const WAVE_NOISE = 4

# ---------------------------------------------------------------------------
# Stream words: 0 = end, 1..99 = wait frames, >=100 = command (+ args)
# ---------------------------------------------------------------------------

const SNDCMD_SET_PITCH      = 100
const SNDCMD_INC_PITCH      = 101
const SNDCMD_SET_VOL        = 102  # vol = vol_target = val; vol_rate = 0
const SNDCMD_SET_VOL_TARGET = 103  # vol_target, vol_rate (rate: close gap*rate/64 per frame)
const SNDCMD_SET_PW         = 104
const SNDCMD_INC_PW         = 105
const SNDCMD_SET_WAVE       = 106
const SNDCMD_LOOP_START     = 107
const SNDCMD_LOOP_END       = 108


# Voice map: 0 gun, 1 move, 2 combat, 3 stinger

struct SoundEffect:
    voice_index
    start0: int*
    start1: int*


