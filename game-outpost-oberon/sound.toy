struct SoundCommandStream:
    pos: int*
    loop: int*
    wait

struct Voice:
    pitch
    pw
    pw_rate
    vol         # 8.8 fixed (>> 8 for APU)
    vol_target  # 8.8 fixed
    vol_rate
    wave
    cmd_streams: SoundCommandStream[2]

var voices: Voice[4]


func play_sound(e: SoundEffect*):
    var v = &voices[e.voice_index]
    v.cmd_streams = {}
    v.cmd_streams[0].pos = e.start0
    v.cmd_streams[1].pos = e.start1


func update_stream(v: Voice*, s: SoundCommandStream*):
    while true:
        if s.wait > 0:
            s.wait -= 1
            return
        var n = s.pos.*
        s.pos += 1
        if n == 0:
            s.pos = s.loop
            if s.pos: continue
            return
        elif n < 100:
            s.wait = n
            continue
        if n == SND_PITCH:
            v.pitch = s.pos.*
            s.pos += 1
        elif n == SND_PITCH_INC:
            v.pitch += s.pos.*
            s.pos += 1
        elif n == SND_VOL:
            v.vol = s.pos.* * 256
            v.vol_target = v.vol
            v.vol_rate = 0
            s.pos += 1
        elif n == SND_VOL_SLIDE:
            v.vol_target = s.pos.* * 256
            s.pos += 1
            v.vol_rate = s.pos.*
            s.pos += 1
        elif n == SND_PW:
            v.pw = s.pos.*
            s.pos += 1
            v.pw_rate = s.pos.*
            s.pos += 1
        elif n == SND_WAVE:
            v.wave = s.pos.*
            s.pos += 1
        elif n == SND_LOOP:
            s.loop = s.pos
        else:
            print("sound error")


func update_vol(v: Voice*):
    if v.vol_rate == 0: return
    if v.vol == v.vol_target: return

    var d = abs(v.vol - v.vol_target)
    var step = d * v.vol_rate / 64
    if step < 1: step = 1

    if v.vol < v.vol_target:
        v.vol = min(v.vol + step, v.vol_target)
    else:
        v.vol = max(v.vol - step, v.vol_target)

func update_sound():
    for i = 0, 4:
        var v = &voices[i]
        update_vol(v)
        v.pw += v.pw_rate
        v.pw %= 256
        for s in v.cmd_streams:
            if s.pos: update_stream(v, s)
        sound(i, v.pitch, v.pw, v.vol / 256, v.wave)
