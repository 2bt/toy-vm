{
  "name": "smolt",
  "displayName": "Smolt Language",
  "description": "Syntax highlighting for the Smolt language (.smolt)",
  "version": "0.0.2",
  "publisher": "smolt",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "smolt",
        "aliases": [
          "Smolt",
          "smolt"
        ],
        "extensions": [
          ".smolt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "smolt",
        "scopeName": "source.smolt",
        "path": "./syntaxes/smolt.tmLanguage.json"
      }
    ]
  }
}
