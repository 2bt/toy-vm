struct Box:
    x
    y
    w
    h

func box_has_point(b: Box*, x, y):
    return (b.x <= x and b.x + b.w > x
        and b.y <= y and b.y + b.h > y)

func box_intersects(b: Box*, o: Box*) int:
    return (b.x < o.x + o.w and b.x + b.w > o.x
        and b.y < o.y + o.h and b.y + b.h > o.y)

func box_grow(b: Box*, amount):
    b.x -= amount
    b.y -= amount
    b.w += amount * 2
    b.h += amount * 2

# origin = tile top-left in subpixels; box = bottom-centered AABB in pixels
func entity_update_box_pos(sx, sy, box: Box*):
    box.x = sx / SP + 8 - box.w / 2
    box.y = sy / SP + 16 - box.h


var camera: Box = { 0, 0, SCREEN_W, SCREEN_H }

func camera_sprite(x, y, w, h, s, t, f):
    sprite(x - camera.x, y - camera.y, w, h, s, t, f)



