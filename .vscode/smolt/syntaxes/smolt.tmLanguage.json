{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Smolt",
  "scopeName": "source.smolt",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.smolt",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.smolt",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.smolt",
          "match": "\\\\."
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.smolt",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.smolt",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.smolt",
          "match": "\\$[0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.decimal.smolt",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.smolt",
          "match": "\\b(if|elif|else|while|for|in|break|continue|return|and|or|not)\\b"
        },
        {
          "name": "keyword.other.smolt",
          "match": "\\b(include|var|const|func|struct|asm|as)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.smolt",
          "match": "\\bint\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.smolt",
          "match": "(\\|=|&=|\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.comparison.smolt",
          "match": "(==|!=|<=|>=|<|>)"
        }
      ]
    }
  }
}
