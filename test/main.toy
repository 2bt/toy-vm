include "../game-breakout/prelude.toy"

func abs(x):
    if x >= 0: return x
    return -x


struct Vec:
    x: int
    y: int

struct Player:
    pos: Vec
    lives: int



var player: Player = { {0, 1} }

var t = 100

func tick():
    t += 10

    var s: Player[2] = {
        {},
        { {}, 7 },
    }

    player.pos = { 1, t * 10 }
    s[0] = player

    print("Hello, world!")


    for i = 0, s[t].lives / 2:
        print("foo!")
