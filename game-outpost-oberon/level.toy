struct Level:
    data: int*
    w
    h
    spawn_x
    spawn_y

    tick

var level: Level

func level_init(data: int*):
    level.data = data
    level.w    = stridx(data, 'X')
    level.h    = strlen(data) / level.w
    level.tick = 0

    var i = stridx(level.data, 'h')
    if i >= 0:
        level.spawn_x = i % level.w * TS
        level.spawn_y = i / level.w * TS
    else:
        i = stridx(level.data, 'S')
        var l = 1
        while level.data[i] == 'S':
            i += 1
            l += 1
        level.spawn_x = i % level.w * TS - l  * TS / 2
        level.spawn_y = i / level.w * TS




func level_get_tile_at_cr(c, r):
    if c < 0 or c >= level.w: return '0'
    if r < 0 or r >= level.h: return '0'
    c = level.data[c + r * level.w]
    if c == 'X': return '0'
    return c

func level_get_tile(x, y):
    return level_get_tile_at_cr(x / TS, y / TS)


func level_update():
    level.tick += 1



func level_draw_background():

    # # parallax
    # var ox = camera.x * 4 / 5 % TS
    # var oy = camera.y * 4 / 5 % TS
    # for r = 0, SCREEN_H / TS + 1:
    #     for c = 0, SCREEN_W / TS + 1:
    #         sprite(c * TS - ox, r * TS - oy, TS, TS, 16, 32, 0)

    var c0 = camera.x / TS
    var r0 = camera.y / TS
    for r = r0, r0 + SCREEN_H / TS + 2:
        for c = c0, c0 + SCREEN_W / TS + 1:
            var t = level_get_tile_at_cr(c, r)
            var x = c * TS - camera.x
            var y = r * TS - camera.y

            if t == '^':  # jump through platform
                sprite(x, y, TS, TS, 4 * TS, 48, 0)

            elif t == 'E':
                var q = level.tick * 2 % 32
                for i = 0, 32:
                    q = (q + 5) % 31
                    if q < i:
                        var color = q > 10 ? 12 : 11
                        sprite(x, y + i - 16, TS, 1, 32, 32 + color, 0)


            elif t == 'S':
                q = level.tick * 2 % 32
                for i = 0, 32:
                    q = (q + 5) % 31
                    if q < i:
                        color = q > 10 ? 12 : 11
                        sprite(x, y + 31 - i, TS, 1, 32, 32 + color, 0)



func level_draw_walls():

    var c0 = camera.x / TS
    var r0 = camera.y / TS
    for r = r0, r0 + SCREEN_H / TS + 2:
        for c = c0, c0 + SCREEN_W / TS + 1:
            var t = level_get_tile_at_cr(c, r)
            var x = c * TS - camera.x
            var y = r * TS - camera.y

            if t == '0':
                # edge
                sprite(x, y, TS, TS, 0, 32, 0)
                if level_get_tile_at_cr(c - 1, r) != '0': sprite(x, y, TS, TS, 0 * TS, 48, 0)
                if level_get_tile_at_cr(c + 1, r) != '0': sprite(x, y, TS, TS, 1 * TS, 48, 0)
                if level_get_tile_at_cr(c, r - 1) != '0': sprite(x, y, TS, TS, 2 * TS, 48, 0)
                if level_get_tile_at_cr(c, r + 1) != '0': sprite(x, y, TS, TS, 3 * TS, 48, 0)

            elif t == 'L':  # lava
                sprite(x, y, TS, TS, 5 * TS, 48, 0)
            elif t == 'l':  # lava surface
                var q = level.tick / 8 % TS
                sprite(x,     y, q,      TS, 6 * TS + TS - q, 48, 0)
                sprite(x + q, y, TS - q, TS, 6 * TS,          48, 0)
