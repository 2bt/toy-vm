# ---------------------------------------------------------------------------
# constants
# ---------------------------------------------------------------------------

const GAME_STATE_TITLE      = 99
const GAME_STATE_LEVEL      = 0
const GAME_STATE_PLAY       = 1
const GAME_STATE_LEVEL_DONE = 2
const GAME_STATE_GAME_OVER  = 3
const GAME_STATE_WIN        = 4

const LEVEL_CARD_FRAMES    = 60
const LEVEL_DONE_FRAMES    = 48

const TS      = 16
const SP      = 16
const GRAVITY = 2

# ---------------------------------------------------------------------------
# data
# ---------------------------------------------------------------------------

struct Game:
    state
    level
    countdown

var game: Game

struct Camera:
    box: Box
    ground_y  # last hero center-y while on ground (or below it while falling)

var camera: Camera = { { 0, 0, SCREEN_W, SCREEN_H }, 0 }

const CAM_MARGIN_H = 120
const CAM_MARGIN_T = 28
const CAM_MARGIN_B = 80

func camera_sprite(x, y, w, h, s, t, f):
    sprite(x - camera.box.x, y - camera.box.y, w, h, s, t, f)

func camera_center_on_hero():
    camera.box.x = box_center_x(hero.box) - SCREEN_W / 2
    camera.box.y = box_center_y(hero.box) - SCREEN_H / 2
    camera.ground_y = box_center_y(hero.box)

func camera_follow_hero():
    var hx = box_center_x(hero.box)
    var hy = box_center_y(hero.box)
    # lock vertical settle target to last stand height; track down while falling
    if hero.on_ground or hy > camera.ground_y: camera.ground_y = hy
    camera.box.x = clamp(camera.box.x, hx + CAM_MARGIN_H - SCREEN_W, hx - CAM_MARGIN_H)
    # live hy: keep hero inside top margin on big jumps / force down when falling
    camera.box.y = clamp(camera.box.y, hy - SCREEN_H / 2, hy - CAM_MARGIN_T)
    # soft-settle up toward last grounded height (continues mid-jump after a climb)
    var ty = camera.ground_y - SCREEN_H / 2
    if ty > 0 and camera.box.y > ty: camera.box.y += (ty - camera.box.y) / 8

func camera_return_toward_spawn():
    var tx = box_center_x(hero.box) - SCREEN_W / 2
    var ty = box_center_y(hero.box) - SCREEN_H / 2
    var dx = tx - camera.box.x
    var dy = ty - camera.box.y
    var l = sqrt(dx * dx + dy * dy)
    if l == 0:
        hero_set_state(HERO_STATE_SPAWNING)
        return
    var speed = clamp(l / 8, 4, 20)
    if l > speed:
        dx = dx * speed / l
        dy = dy * speed / l
    camera.box.x += dx
    camera.box.y += dy




include "level.toy"
include "particle.toy"
include "enemy.toy"
include "hero.toy"


# ---------------------------------------------------------------------------
# game loop
# ---------------------------------------------------------------------------

func game_init():
    game = {}
    game_set_state(GAME_STATE_TITLE)
    game_init_level(LEVEL_TITLE_DATA)
    music_play(MUSIC_TITLE)


func game_set_state(s):
    game.state = s
    if s == GAME_STATE_LEVEL:
        game.countdown = LEVEL_CARD_FRAMES
        music_play("")
    elif s == GAME_STATE_PLAY:
        game_init_level(LEVEL_DATA[game.level])
        music_play(MUSIC_LEVEL)

    elif s == GAME_STATE_LEVEL_DONE:
        game.countdown = LEVEL_DONE_FRAMES
        music_play("")
    elif s == GAME_STATE_GAME_OVER:
        music_play(MUSIC_GAME_OVER)


func game_init_level(data: int*):
    level_init(data)
    hero_place_at_start()
    camera_center_on_hero()
    enemy_init_all()
    for b in hero_bullets: b.* = {}
    for eb in enemy_bullets: eb.* = {}
    for p in particles: p.* = {}


func game_update():

    if game.state == GAME_STATE_TITLE:
        level_update()
        enemy_update_all()
        enemy_bullet_update_all()
        particle_update_all()
        if btnp(BTN_A) or btnp(BTN_B):
            hero_init()
            game_set_state(GAME_STATE_LEVEL)
        return


    if game.state == GAME_STATE_LEVEL:
        if game.countdown > 0: game.countdown -= 1
        else: game_set_state(GAME_STATE_PLAY)
        return

    if game.state == GAME_STATE_LEVEL_DONE:
        if game.countdown > 0: game.countdown -= 1
        else:
            game.level += 1
            if game.level >= LEVEL_DATA.len:
                game_set_state(GAME_STATE_WIN)
            else:
                game_init_level(LEVEL_DATA[game.level])
                game_set_state(GAME_STATE_LEVEL)
                return

    elif game.state == GAME_STATE_GAME_OVER or game.state == GAME_STATE_WIN:
        if btnp(BTN_A) or btnp(BTN_B):
            game_init()

    level_update()

    if game.state == GAME_STATE_PLAY:
        hero_update()

    enemy_update_all()
    hero_bullet_update_all()
    enemy_bullet_update_all()
    particle_update_all()



func draw_hud():
    # sprite(2, 2, 6, 11, 5, 165, 0)
    strnum(str, hero.lives)
    draw_text(2, SCREEN_H - 10, "x")
    draw_text(10, SCREEN_H - 10, str)
    strnum(str, hero.score)
    draw_text(SCREEN_W - strlen(str) * 8 - 2, SCREEN_H - 10, str)


func draw_blend():


func game_draw():

    if game.state == GAME_STATE_TITLE:

        level_draw_background()
        enemy_draw_all()
        enemy_bullet_draw_all()
        particle_draw_all()
        level_draw_walls()

        # title
        sprite(SCREEN_W/2 - 112/2, 28, 112, 64, 256, 448, 0)

        draw_blend()
        return

    if game.state == GAME_STATE_LEVEL:
        var p = strcpy(str, "LEVEL ")
        strnum(p, game.level + 1)
        draw_centered_text(SCREEN_W / 2, SCREEN_H / 2 - 4, str)
        return

    level_draw_background()
    enemy_draw_all()

    if game.state == GAME_STATE_PLAY:
        hero_draw()

    draw_blend()


    hero_bullet_draw_all()
    enemy_bullet_draw_all()
    particle_draw_all()
    level_draw_walls()

    level_draw_dots()

    draw_hud()

    if game.state == GAME_STATE_GAME_OVER:
        draw_centered_text(SCREEN_W / 2, SCREEN_H / 2 - 4, "GAME OVER")
    elif game.state == GAME_STATE_WIN:
        draw_centered_text(SCREEN_W / 2, SCREEN_H / 2 - 4, "THE END")
